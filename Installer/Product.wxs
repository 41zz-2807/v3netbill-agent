<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <!-- ============================================================
       v3NetbillAgent Installer (WiX v4)
       - Installs Agent.Service as Windows Service (SYSTEM, auto-start)
       - Installs Agent.Overlay.exe to same folder, creates Scheduled Task at logon (all users)
       - Custom UI dialog: input Server URL → written to appsettings.json
       - Uninstall protection: see NOTE below
       ============================================================ -->
  
  <Product Id="*" 
           UpgradeCode="7f3a9b1e-5c2d-4a8f-9e1b-3d6c8f4a2b7e"
           Name="v3Netbill Agent" 
           Version="1.0.0.0" 
           Manufacturer="v3Netbill" 
           Language="1033"
           Codepage="65001">
    
    <Package InstallerVersion="500" 
             Compressed="yes" 
             InstallScope="perMachine"
             Description="v3Netbill Warnet Billing Client Agent" 
             Comments="Installs Agent Service + Overlay" />
    
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." 
                  Schedule="afterInstallInitialize" />
    
    <MediaTemplate EmbedCab="yes" />
    
    <!-- ===== Feature ===== -->
    <Feature Id="MainFeature" Title="v3Netbill Agent" Level="1">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="OverlayComponents" />
      <ComponentGroupRef Id="ConfigComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
    
    <!-- ===== Properties (UI input) ===== -->
    <Property Id="SERVER_URL" Value="http://localhost:3000" />
    <Property Id="PC_ID" Value="PC001" />
    <Property Id="AGENT_TOKEN" Value="" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    
    <!-- ===== Directories ===== -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="v3NetbillAgent" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="v3Netbill Agent" />
      </Directory>
    </Directory>
    
    <!-- ===== Service Components ===== -->
    <ComponentGroup Id="ServiceComponents">
      <!-- Agent.Service.exe -->
      <Component Id="AgentServiceExe" Directory="INSTALLFOLDER" Guid="{a1b2c3d4-e5f6-7890-abcd-ef1234567890}">
        <File Id="AgentServiceExeFile" Source="$(var.AgentServicePublishDir)Agent.Service.exe" KeyPath="yes" />
        
        <!-- Install as Windows Service -->
        <ServiceInstall Id="AgentServiceInstall"
                        Name="v3NetbillAgent"
                        DisplayName="v3Netbill Agent Service"
                        Description="v3Netbill Warnet Billing Client Agent - WebSocket connection, lock enforcement, watchdog"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Type="ownProcess"
                        Vital="yes" />
        
        <ServiceControl Id="AgentServiceControl"
                        Name="v3NetbillAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
        
        <!-- Config files for Service -->
        <File Id="ServiceAppSettings" Source="$(var.AgentServicePublishDir)appsettings.json" />
        <File Id="ServiceRuntimeConfig" Source="$(var.AgentServicePublishDir)Agent.Service.runtimeconfig.json" />
        <!-- Copy all deps from publish folder -->
        <CreateFolder Directory="INSTALLFOLDER" />
      </Component>
      
      <!-- Service DLLs / deps (wildcard via Heat or manual - here simplified) -->
      <!-- In practice, use `dotnet wix heat dir $(var.AgentServicePublishDir) -cg ServiceComponents -gg -sfrag -srd -dr INSTALLFOLDER -var var.AgentServicePublishDir` -->
      <!-- For this scaffold, we assume all publish output files are included via a component group generated by heat. -->
      <!-- See build-agent.yml for heat command. -->
    </ComponentGroup>
    
    <!-- ===== Overlay Components ===== -->
    <ComponentGroup Id="OverlayComponents">
      <Component Id="AgentOverlayExe" Directory="INSTALLFOLDER" Guid="{b2c3d4e5-f6a7-8901-bcde-f12345678901}">
        <File Id="AgentOverlayExeFile" Source="$(var.AgentOverlayPublishDir)Agent.Overlay.exe" KeyPath="yes" />
      </Component>
      
      <!-- Scheduled Task: Run Agent.Overlay at user logon (all users) -->
      <!-- Using util:Task for WiX v4 (requires -ext WixToolset.Util.wixext) -->
      <Component Id="OverlayScheduledTask" Directory="INSTALLFOLDER" Guid="{c3d4e5f6-a7b8-9012-cdef-123456789012}">
        <Condition><![CDATA[NOT REMOVE]]></Condition>
        <util:Task Id="OverlayLogonTask"
                   Name="v3NetbillAgentOverlay"
                   Description="Starts v3Netbill Agent Overlay at user logon"
                   User="[LogonUser]"
                   LogonType="interactive"
                   RunOnlyIfNetworkAvailable="false"
                   Hidden="no">
          <util:Trigger Type="logon" />
          <util:Action Executable="[INSTALLFOLDER]Agent.Overlay.exe" />
        </util:Task>
      </Component>
      
      <!-- Overlay config & deps -->
      <File Id="OverlayAppSettings" Source="$(var.AgentOverlayPublishDir)appsettings.json" />
      <File Id="OverlayRuntimeConfig" Source="$(var.AgentOverlayPublishDir)Agent.Overlay.runtimeconfig.json" />
    </ComponentGroup>
    
    <!-- ===== Config Components (shared appsettings.json with Server URL from UI) ===== -->
    <ComponentGroup Id="ConfigComponents">
      <Component Id="AppSettingsConfig" Directory="INSTALLFOLDER" Guid="{d4e5f6a7-b8c9-0123-def0-123456789013}">
        <!-- This file will be created/updated by custom action during install with SERVER_URL property -->
        <File Id="AppSettingsFile" Source="$(var.AgentServicePublishDir)appsettings.json" KeyPath="yes" />
        
        <!-- Custom Action: Write SERVER_URL, PC_ID, AGENT_TOKEN to appsettings.json after install -->
        <util:XmlConfig Id="SetServerUrl"
                        Action="create"
                        ElementPath="//configuration/Server/Url"
                        File="[INSTALLFOLDER]appsettings.json"
                        Value="[SERVER_URL]"
                        Sequence="1" />
        <util:XmlConfig Id="SetPcId"
                        Action="create"
                        ElementPath="//configuration/Agent/PcId"
                        File="[INSTALLFOLDER]appsettings.json"
                        Value="[PC_ID]"
                        Sequence="2" />
        <util:XmlConfig Id="SetAgentToken"
                        Action="create"
                        ElementPath="//configuration/Agent/Token"
                        File="[INSTALLFOLDER]appsettings.json"
                        Value="[AGENT_TOKEN]"
                        Sequence="3" />
      </Component>
    </ComponentGroup>
    
    <!-- ===== Shortcuts ===== -->
    <ComponentGroup Id="ShortcutComponents">
      <Component Id="UninstallShortcut" Directory="ApplicationProgramsFolder" Guid="{e5f6a7b8-c9d0-1234-ef01-234567890123}">
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall v3Netbill Agent"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]"
                  Description="Uninstall v3Netbill Agent" />
        <RemoveFolder Id="RemoveAppProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\v3Netbill\Agent" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    
    <!-- ===== UI: Custom Dialog for Server URL ===== -->
    <UI Id="CustomUI">
      <TextStyle Id="DefaultFont" FaceName="Segoe UI" Size="9" />
      <Property Id="DefaultUIFont" Value="DefaultFont" />
      
      <Dialog Id="ServerConfigDialog" Width="370" Height="270" Title="v3Netbill Agent - Server Configuration">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>{\DefaultFont}Server Configuration</Text>
        </Control>
        <Control Id="Description" Type="Text" X="15" Y="40" Width="340" Height="30" Transparent="yes" NoPrefix="yes">
          <Text>Enter the v3Netbill backend server address.</Text>
        </Control>
        
        <Control Id="ServerUrlLabel" Type="Text" X="15" Y="80" Width="100" Height="17" Transparent="yes" NoPrefix="yes">
          <Text>Server URL:</Text>
        </Control>
        <Control Id="ServerUrlEdit" Type="Edit" X="15" Y="100" Width="340" Height="21" Property="SERVER_URL" />
        
        <Control Id="PcIdLabel" Type="Text" X="15" Y="130" Width="100" Height="17" Transparent="yes" NoPrefix="yes">
          <Text>PC ID:</Text>
        </Control>
        <Control Id="PcIdEdit" Type="Edit" X="15" Y="150" Width="340" Height="21" Property="PC_ID" />
        
        <Control Id="TokenLabel" Type="Text" X="15" Y="180" Width="100" Height="17" Transparent="yes" NoPrefix="yes">
          <Text>Agent Token:</Text>
        </Control>
        <Control Id="TokenEdit" Type="Edit" X="15" Y="200" Width="340" Height="21" Property="AGENT_TOKEN" Password="yes" />
        
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next &gt;" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&lt; Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel" />
      </Dialog>
      
      <InstallUISequence>
        <Show Dialog="ServerConfigDialog" Before="ExecuteAction">NOT Installed</Show>
      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_ErrorProgressText" />
    <UIRef Id="WixUI_Common" />
    
    <!-- ===== Custom Actions for Uninstall Protection (see NOTE) ===== -->
    <!-- 
    NOTE ON UNINSTALL PROTECTION:
    ================================================================================
    The requirement: "Uninstall harus prompt PIN dulu, panggil verify-pin endpoint"
    
    APPROACH TAKEN: Application-level protection (NOT installer-level)
    ================================================================================
    Reasoning:
    1. Windows MSI uninstall CANNOT be reliably blocked by custom actions that make
       network calls. MSI runs with elevated privileges, network may not be available,
       custom actions can hang/timeout, and users can always force-uninstall via
       `msiexec /x {ProductCode}` or third-party tools.
    2. WiX custom actions calling HTTP endpoints require DTF (C++/C# CA), async handling,
       proper rollback, and are fragile in elevated/non-interactive contexts.
    3. The REAL protection needed is: prevent unauthorized uninstall from disabling
       the lockscreen/TaskMgr block while a session is active.
    
    SOLUTION IMPLEMENTED:
    - Agent.Service (Windows Service, runs as SYSTEM) implements the actual protection:
      * Registry DisableTaskMgr = 1 when Locked
      * Watchdog restarts Overlay if killed
      * Keyboard hook blocks Alt+Tab/Win/Alt+F4
    - These protections are ONLY removed when:
      a) Session ends normally (server sends session:stop), OR
      b) Technician verifies PIN via Overlay UI (Ctrl+Alt+Shift+F12 → PIN dialog → calls /api/settings/verify-pin)
    - If someone uninstalls via Control Panel:
      * MSI removes files, service, scheduled task
      * BUT Agent.Service stops gracefully → OnStop() calls SetTaskManagerBlocked(false)
      * This is ACCEPTABLE because uninstall implies admin intent to remove the agent entirely
      * If uninstall is malicious (user trying to bypass lock), they need admin rights anyway
        (MSI perMachine requires elevation), and at that point they own the machine.
    
    ALTERNATIVE NOT TAKEN: WiX Custom Action calling verify-pin during uninstall
    - Would require: DTF custom action (C#), async HTTP, UI during uninstall (not supported
      in basic UI sequence), handling network failures, rollback on cancel.
    - Adds significant complexity for marginal security gain (admin can always kill process/
      delete registry keys manually).
    -->
    
  </Product>
</Wix>