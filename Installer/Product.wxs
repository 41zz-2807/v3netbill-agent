<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- ============================================================
       v3NetbillAgent Installer (WiX v4)
       Layout:
         [ProgramFilesFolder]\v3NetbillAgent\
           Agent.Service\   <- Agent.Service.exe + deps  (Windows Service, SYSTEM)
           Agent.Overlay\   <- Agent.Overlay.exe + deps  (shortcut di Startup all-users)
       Konfigurasi (ServerUrl/PcId/AgentToken) ditulis KE REGISTRY HKLM
       oleh MSI native (transactional, tanpa custom action). Agent membaca
       override registry dengan prioritas di atas appsettings.json.

       Overlay dijalankan saat logon lewat shortcut di StartupFolder
       (MSI native); jika mati, dihidupkan ulang oleh watchdog di Agent.Service.

       Dep fragment di-generate oleh skrip di build-agent.yml:
          SvcDepFiles.wxs (cg SvcDepComponents, dr SVCFOLDER)
          OverlayDepFiles.wxs (cg OverlayDepComponents, dr OVERLAYFOLDER)
       ============================================================ -->

  <Package UpgradeCode="7f3a9b1e-5c2d-4a8f-9e1b-3d6c8f4a2b7e"
           Name="v3Netbill Agent"
           Version="1.0.5.0"
           Manufacturer="v3Netbill"
           Language="1033"
           Codepage="65001"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Versi yang lebih baru sudah terpasang."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- UI wizard: WixUI_InstallDir + dialog konfigurasi server di awal.
         Pattern mengikuti unit test resmi WiX v4 (InstallDir_SpecialDlg).
         License RTF default berasal dari $(var.licenseRtf) (di-set via -d saat build). -->
    <ui:WixUI Id="InstallDir_ServerConfig" InstallDirectory="INSTALLFOLDER" />

    <!-- ===== Feature ===== -->
    <Feature Id="MainFeature" Title="v3Netbill Agent" Level="1">
      <ComponentGroupRef Id="SvcExeComponents" />
      <ComponentGroupRef Id="SvcDepComponents" />        <!-- dari generator -->
      <ComponentGroupRef Id="OverlayExeComponents" />
      <ComponentGroupRef Id="OverlayDepComponents" />    <!-- dari generator -->
      <ComponentGroupRef Id="ConfigComponents" />
      <ComponentGroupRef Id="OverlayStartupComponents" />
      <ComponentGroupRef Id="UninstallShortcutComponents" />
    </Feature>

    <!-- ===== Properties (input pengguna) ===== -->
    <Property Id="SERVER_URL" Value="https://v3netbill.<domain>" />
    <Property Id="PC_ID" Value="PC001">
      <RegistrySearch Id="PrefillPcId" Root="HKLM" Key="Software\v3Netbill\Agent" Name="PcId" Type="raw" />
    </Property>
    <Property Id="AGENT_TOKEN" Secure="yes">
      <RegistrySearch Id="PrefillAgentToken" Root="HKLM" Key="Software\v3Netbill\Agent" Name="AgentToken" Type="raw" />
    </Property>

    <!-- ===== Uninstall protection: PIN admin (diverifikasi backend) memakai
         custom action Type 18 (Agent.Overlay.exe --uninstall-guard) sebelum
         RemoveFiles. Tombol Remove/Repair di Apps & Features dibiarkan aktif
         agar uninstall tetap bisa dijalankan — tapi siapa pun yang mencoba
         harus memasukkan PIN Uninstall yang diset Admin di dashboard. =====
         (ARPNOREMOVE/ARPNOREPAIR tidak lagi dipakai.) -->

    <!-- ===== Directories ===== -->
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="v3NetbillAgent">
        <Directory Id="SVCFOLDER" Name="Agent.Service" />
        <Directory Id="OVERLAYFOLDER" Name="Agent.Overlay" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder" />
    <StandardDirectory Id="ProgramsMenuFolder">
      <Directory Id="ProgramMenuDir" Name="v3Netbill Agent" />
    </StandardDirectory>

    <!-- ===== Service (komponen manual: exe + service install/control) ===== -->
    <ComponentGroup Id="SvcExeComponents">
      <Component Id="AgentServiceExe" Directory="SVCFOLDER"
                 Guid="{a1b2c3d4-e5f6-7890-abcd-ef1234567890}">
        <File Id="AgentServiceExeFile"
              Source="$(var.SvcPublishDir)Agent.Service.exe"
              KeyPath="yes" />

        <ServiceInstall Id="AgentServiceInstall"
                        Name="v3NetbillAgent"
                        DisplayName="v3Netbill Agent Service"
                        Description="v3Netbill Warnet Billing Client Agent - WebSocket connection, lock enforcement, watchdog"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Type="ownProcess"
                        Vital="yes" />

        <ServiceControl Id="AgentServiceControl"
                        Name="v3NetbillAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <File Id="ServiceDepsJson" Source="$(var.SvcPublishDir)Agent.Service.deps.json" />
        <File Id="ServiceRuntimeConfig" Source="$(var.SvcPublishDir)Agent.Service.runtimeconfig.json" />
        <File Id="ServiceAppSettings" Source="$(var.SvcPublishDir)appsettings.json" />
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ===== Overlay (komponen manual: exe) ===== -->
    <ComponentGroup Id="OverlayExeComponents">
      <Component Id="AgentOverlayExe" Directory="OVERLAYFOLDER"
                 Guid="{b2c3d4e5-f6a7-8901-bcde-f12345678901}">
        <File Id="AgentOverlayExeFile"
              Source="$(var.OverlayPublishDir)Agent.Overlay.exe"
              KeyPath="yes" />
        <File Id="OverlayDepsJson" Source="$(var.OverlayPublishDir)Agent.Overlay.deps.json" />
        <File Id="OverlayRuntimeConfig" Source="$(var.OverlayPublishDir)Agent.Overlay.runtimeconfig.json" />
        <File Id="OverlayAppSettings" Source="$(var.OverlayPublishDir)appsettings.json" />
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ===== Config registry (ditulis native oleh MSI) ===== -->
    <ComponentGroup Id="ConfigComponents">
      <Component Id="AgentConfigRegistry" Directory="INSTALLFOLDER"
                 Guid="{d4e5f6a7-b8c9-0123-def0-123456789013}">
        <RegistryKey Root="HKLM" Key="Software\v3Netbill\Agent">
          <RegistryValue Name="ServerUrl" Type="string" Value="[SERVER_URL]" KeyPath="yes" />
          <RegistryValue Name="PcId" Type="string" Value="[PC_ID]" />
          <RegistryValue Name="AgentToken" Type="string" Value="[AGENT_TOKEN]" />
        </RegistryKey>
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <!-- ===== Overlay di Startup (user yang memasang) ===== -->
    <ComponentGroup Id="OverlayStartupComponents">
      <Component Id="OverlayStartupShortcut" Directory="StartupFolder"
                 Guid="{c3d4e5f6-a7b8-9012-cdef-123456789012}">
        <Shortcut Id="OverlayStartupShortcutLink"
                  Name="v3Netbill Agent Overlay"
                  Target="[OVERLAYFOLDER]Agent.Overlay.exe"
                  Description="v3Netbill Agent Overlay" />
        <RemoveFolder Id="RemoveOverlayStartupFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\v3Netbill\Agent"
                       Name="OverlayStartup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ===== Shortcut uninstall (Start Menu): jalankan msiexec /x [ProductCode].
         Custom action di bawah yang memastikan PIN admin keburu diverifikasi. ===== -->
    <ComponentGroup Id="UninstallShortcutComponents">
      <Component Id="UninstallShortcut" Directory="ProgramMenuDir"
                 Guid="{e5f6a7b8-c9d0-1234-5678-fedcba987654}">
        <Shortcut Id="UninstallShortcutLink"
                  Name="Uninstall v3Netbill Agent"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]"
                  Description="Uninstall v3Netbill Agent (meminta PIN admin)" />
        <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\v3Netbill\Agent"
                       Name="UninstallShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ===== Verifikasi PIN sebelum uninstall berjalan (Type 18 exe CA).
         MenjalankanAgent.Overlay.exe --uninstall-guard tepat sebelum RemoveFiles.
         Exit 0 = lanjut, non-zero = batal uninstall. Hanya uninstall murni
         (REMOVE="ALL"), TIDAK saat major upgrade (UPGRADINGPRODUCTCODE). ===== -->
    <CustomAction Id="UninstallGuardAction"
                  FileRef="AgentOverlayExeFile"
                  ExeCommand="--uninstall-guard"
                  Execute="immediate"
                  Return="check" />

    <InstallExecuteSequence>
      <Custom Action="UninstallGuardAction" Before="RemoveFiles">
        REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE
      </Custom>
    </InstallExecuteSequence>

    <!-- ===== Shortcuts (start menu): TIDAK ada shortcut uninstall (hardening).
         Agent tidak boleh di-uninstall user biasa; hanya lewat msiexec /x
         yang dilindungi PIN (verify-pin) seperti dijelaskan di catatan akhir. ===== -->
  </Package>

    <!-- ===== UI: dialog config + override sequence WixUI_InstallDir ===== -->
    <!-- Fragment 1: definisi dialog konfigurasi server -->
    <Fragment>
      <UI>
        <Dialog Id="ServerConfigDialog" Width="370" Height="270" Title="v3Netbill Agent - Konfigurasi Server">
          <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
          <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
          <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
          <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
            <Text Value="Konfigurasi Server" />
          </Control>
          <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="30" Transparent="yes" NoPrefix="yes">
            <Text Value="Isi alamat server billing, ID PC, dan Token agent yang dibuat di dashboard." />
          </Control>

          <Control Id="ServerUrlLabel" Type="Text" X="15" Y="80" Width="100" Height="17" Transparent="yes" NoPrefix="yes">
            <Text Value="Server URL:" />
          </Control>
          <Control Id="ServerUrlEdit" Type="Edit" X="15" Y="100" Width="340" Height="21" Property="SERVER_URL" />

          <Control Id="PcIdLabel" Type="Text" X="15" Y="130" Width="100" Height="17" Transparent="yes" NoPrefix="yes">
            <Text Value="PC ID:" />
          </Control>
          <Control Id="PcIdEdit" Type="Edit" X="15" Y="150" Width="340" Height="21" Property="PC_ID" />

          <Control Id="TokenLabel" Type="Text" X="15" Y="180" Width="100" Height="17" Transparent="yes" NoPrefix="yes">
            <Text Value="Agent Token:" />
          </Control>
          <Control Id="TokenEdit" Type="Edit" X="15" Y="200" Width="340" Height="21" Property="AGENT_TOKEN" Password="yes" />

          <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
          <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
          <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
            <Publish Event="SpawnDialog" Value="CancelDlg" />
          </Control>
        </Dialog>
      </UI>
    </Fragment>

    <!-- Fragment 2: referensi per-arch UI (mengikuti WixUI_InstallDir) -->
    <?foreach WIXUIARCH in X86;X64;A64 ?>
    <Fragment>
      <UI Id="InstallDir_ServerConfig_$(WIXUIARCH)">
        <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_$(WIXUIARCH)" />
        <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_$(WIXUIARCH)" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
        <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_$(WIXUIARCH)" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      </UI>

      <UIRef Id="InstallDir_ServerConfig" />
    </Fragment>
    <?endforeach?>

    <!-- Fragment 3: UI override — salinan WixUI_InstallDir dengan ServerConfigDialog
         disisipkan: WelcomeDlg -> ServerConfigDialog -> LicenseAgreementDlg -> InstallDirDlg -->
    <Fragment>
      <UI Id="file InstallDir_ServerConfig">
        <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
        <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
        <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />

        <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

        <DialogRef Id="BrowseDlg" />
        <DialogRef Id="DiskCostDlg" />
        <DialogRef Id="ErrorDlg" />
        <DialogRef Id="FatalError" />
        <DialogRef Id="FilesInUse" />
        <DialogRef Id="MsiRMFilesInUse" />
        <DialogRef Id="PrepareDlg" />
        <DialogRef Id="ProgressDlg" />
        <DialogRef Id="ResumeDlg" />
        <DialogRef Id="UserExit" />

        <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

        <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

        <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ServerConfigDialog" />
        <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

        <Publish Dialog="ServerConfigDialog" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
        <Publish Dialog="ServerConfigDialog" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" />

        <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="ServerConfigDialog" />
        <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

        <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
        <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
        <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
        <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
        <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
        <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />
        <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" Condition="NOT Installed" />
        <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
        <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

        <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

        <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
        <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
        <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

        <Property Id="ARPNOMODIFY" Value="1" />
      </UI>

      <UIRef Id="WixUI_Common" />
    </Fragment>

    <!-- ===== Catatan uninstall protection =====
         Uninstall TETAP tersedia (tombol Remove di Apps & Features + shortcut
         Start Menu "Uninstall v3Netbill Agent"). Namun setiap uninstall murni
         melewati custom action UninstallGuardAction (Type 18) yang menjalankan
         Agent.Overlay.exe --uninstall-guard sebelum RemoveFiles: admin harus
         memasukkan PIN Uninstall (diset di dashboard, diverifikasi via
         POST /api/settings/verify-pin). Salah PIN / server tak terjangkau →
         uninstall dibatalkan (Return="check"). Major upgrade TIDAK meminta PIN
         (kondisi NOT UPGRADINGPRODUCTCODE).
         Proteksi lain tetap: registry DisableTaskMgr (0 saat desktop normal),
         watchdog scheduled task restart service tiap 1 menit. Saat uninstall,
         service berhenti &amp; memanggil SetTaskManagerBlocked(false). ===== -->
</Wix>