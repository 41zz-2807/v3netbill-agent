<Window x:Class="V3Netbill.Agent.Overlay.UninstallGuardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="v3Netbill Agent — Verifikasi Uninstall"
        Width="420" Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#FFFFFFFF"
        Closing="OnClosing">
    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.18" Color="#0F172A"/>
    </Window.Effect>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header pastel, sama seperti kartu login -->
        <Border CornerRadius="0" Padding="18,14,18,14" Background="#FFE0F7FA">
            <StackPanel>
                <TextBlock Text="Uninstall Agent" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="v3Netbill Warnet Billing" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="22,16,22,20">
            <TextBlock Text="Masukkan PIN admin (PIN Uninstall) untuk melanjutkan penghapusan agent."
                       FontSize="13" Foreground="#334155" TextWrapping="Wrap"/>
            <TextBlock Text="PIN diverifikasi ke server billing. Uninstall dibatalkan bila PIN salah."
                       FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,12"/>

            <TextBlock Text="PIN Uninstall" FontSize="11" FontWeight="SemiBold" Foreground="#00B894"/>
            <PasswordBox x:Name="PinBox"
                         Height="34"
                         FontSize="14"
                         Background="#FFFFFF"
                         Foreground="#0F172A"
                         BorderBrush="#50F6FF"
                         BorderThickness="1"
                         Padding="8,0,8,0"
                         Margin="0,4,0,10"
                         KeyDown="OnPinKeyDown"/>

            <TextBlock x:Name="StatusText"
                       FontSize="11.5" Foreground="#FFD166"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="CancelButton"
                        Content="Batal"
                        Width="110" Height="36"
                        FontSize="13" FontWeight="Bold"
                        Background="#28324E" Foreground="#0F172A"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="OnCancel"/>
                <Button x:Name="VerifyButton"
                        Content="Hapus Agent"
                        Width="130" Height="36"
                        FontSize="13" FontWeight="Bold"
                        Background="#049FBB" Foreground="#0F172A"
                        BorderThickness="0" Cursor="Hand"
                        IsDefault="True"
                        Click="OnVerify"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>