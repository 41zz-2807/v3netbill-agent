<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>V3Netbill.Agent.Overlay</RootNamespace>
    <AssemblyName>Agent.Overlay</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Ikon aplikasi Windows; juga dipakai ulang oleh WiX untuk ikon installer. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ProjectGuid>{9C2B7EC2-D2A8-4E8F-8A99-51D4A46C0E7A}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Core\Agent.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ditulis eksplisit, bukan mengandalkan glob bawaan WPF, supaya gambar
         pasti tersedia sebagai Resource dan bisa dipakai lewat pack URI. -->
    <Resource Include="Assets\logo-v3netbill.png" />
  </ItemGroup>

</Project>
