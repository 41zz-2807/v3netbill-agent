<Application x:Class="V3Netbill.Agent.Overlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Resource ini dipakai lebih dari satu jendela, jadi ditaruh di level
             aplikasi, bukan di Window.Resources. Resource di dalam
             Window.Resources hanya bisa dilihat oleh jendela itu sendiri, jadi
             dialog ganti password yang terpisah tidak akan menemukannya kalau
             masih ditaruh di sana. -->

        <LinearGradientBrush x:Key="FieldInsetBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33000000" Offset="0"/>
            <GradientStop Color="#1A000000" Offset="0.30"/>
            <GradientStop Color="#0A000000" Offset="0.70"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FieldCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Template field berbentuk pil. PART_ContentHost wajib dipakai agar
             PasswordBox tetap menampilkan teks dengan benar. -->
        <ControlTemplate x:Key="PillPasswordTemplate" TargetType="PasswordBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="23">
                <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#00D4AA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Application.Resources>
</Application>
