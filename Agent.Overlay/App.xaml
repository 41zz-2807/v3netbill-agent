<Application x:Class="V3Netbill.Agent.Overlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Resource ini dipakai lebih dari satu jendela, jadi ditaruh di level
             aplikasi, bukan di Window.Resources. Resource di dalam
             Window.Resources hanya bisa dilihat oleh jendela itu sendiri, jadi
             dialog ganti password yang terpisah tidak akan menemukannya kalau
             masih ditaruh di sana. -->

        <!-- Palet disamakan dengan kartu PC di aplikasi web: header pastel
             cyan, panel putih, teks slate. Aksen teal #00D4AA tetap dipakai
             karena itu warna aksi utama di aplikasi ini (LOGIN, fokus field,
             garis timeline hijau). -->
        <Color x:Key="PastelHeaderColor">#E0F7FA</Color>
        <Color x:Key="TeksGelapColor">#0F172A</Color>
        <Color x:Key="TeksSedangColor">#334155</Color>
        <Color x:Key="TeksRedupColor">#64748B</Color>
        <Color x:Key="GarisColor">#CBD5E1</Color>
        <Color x:Key="AksenColor">#00D4AA</Color>

        <!-- Insets untuk field. Di tema gelap ini gradien hitam; di tema terang
             cukup garis tipis, jadi isinya dibuat nyaris tak terlihat. Tetap
             dipakai supaya tema bisa diubah dari satu tempat. -->
        <LinearGradientBrush x:Key="FieldInsetBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0A0F172A" Offset="0"/>
            <GradientStop Color="#000F172A" Offset="0.35"/>
            <GradientStop Color="#000F172A" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FieldCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Template field berbentuk pil. PART_ContentHost wajib dipakai agar
             PasswordBox tetap menampilkan teks dengan benar. -->
        <ControlTemplate x:Key="PillPasswordTemplate" TargetType="PasswordBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="23">
                <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#00D4AA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

          <!-- ===== Field login gaya mockup (garis bawah, bukan pil) =====
               Mockup "form_login_webdanpc.jpg" memakai field BERGARIS BAWAH
               dengan ikon di kiri, bukan kotak rounded. Template di sini
               membuang border bawaan WPF; garisnya digambar oleh Border
               pembungkus di MainWindow.xaml, jadi template ini hanya butuh
               content presenter.

               ⚠️ PENTING: pemanggil harus mengeset BorderThickness="0".
               Kalau tidak, field tampil dengan kotak built-in WPF DAN garis
               bawah dari Border pembungkus — dua garis, dan yang bawaan WPF
               membuat mockup tidak tercapai sama sekali. -->
          <ControlTemplate x:Key="UnderlineFieldTemplate" TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="Center"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
          </ControlTemplate>

          <!-- PasswordBox tidak bisa memakai template TextBox: TargetType-nya
               berbeda dan WPF menolaknya. Butuh salinan sendiri. -->
          <ControlTemplate x:Key="UnderlinePasswordTemplate" TargetType="PasswordBox">
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="Center"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
          </ControlTemplate>
    </Application.Resources>
</Application>