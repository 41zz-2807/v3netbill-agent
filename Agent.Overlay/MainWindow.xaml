<Window x:Class="V3Netbill.Agent.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="v3Netbill Agent Overlay"
        Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowState="Normal"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="OverlayTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Meniru box-shadow: inset 2px 5px 10px dari CSS Uiverse. WPF tidak punya
             inner shadow, jadi dipakai gradien yang lebih gelap di atas lalu memudar
             ke bawah. Satu elemen, tanpa Border bersarang. -->
        <LinearGradientBrush x:Key="FieldInsetBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33000000" Offset="0"/>
            <GradientStop Color="#1A000000" Offset="0.30"/>
            <GradientStop Color="#0A000000" Offset="0.70"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FieldCaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A93A6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Timeline mini panel. Warnanya ikut sisa waktu: >60% hijau, 30-60% kuning,
             <=30% merah. Ketiganya mutually exclusive, jadi tidak saling tumpang tindih. -->
        <Style x:Key="TimelineStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2FBF71"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWaktuSedang}" Value="True">
                    <Setter Property="Foreground" Value="#F0B429"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWaktuKritis}" Value="True">
                    <Setter Property="Foreground" Value="#FF5252"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Template field berbentuk pil. PART_ContentHost wajib dipakai agar
             TextBox/PasswordBox tetap menjulkan teks dengan benar. -->
        <ControlTemplate x:Key="PillFieldTemplate" TargetType="TextBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="23">
                <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#00D4AA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="PillPasswordTemplate" TargetType="PasswordBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="23">
                <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#00D4AA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Fullscreen overlay background (visible when Locked) -->
        <Border x:Name="OverlayBackground" 
                Background="#CC000000" 
                Visibility="Collapsed"/>

        <!-- Main content centered -->
        <StackPanel x:Name="ContentPanel" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Width="420"
                    Visibility="Visible">
            
            <!-- Login Card (visible when Locked) -->
            <Border x:Name="LoginCard" 
                    Background="#F21A1A22" 
                    CornerRadius="20" 
                    Padding="34,30"
                    Visibility="Visible">
                <StackPanel>
                    <Image Source="/Assets/logo-v3netbill.png"
                           Height="64"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>
                    <TextBlock Text="LOGIN VOUCHER / MEMBER" 
                               FontSize="18" FontWeight="SemiBold" 
                               Style="{StaticResource OverlayTextStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#868E96"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ServerStatus}" Value="connected">
                                            <Setter Property="Fill" Value="#2F9E44"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ServerStatus}" Value="disconnected">
                                            <Setter Property="Fill" Value="#E03131"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ServerStatusText}"
                                   FontSize="11"
                                   Style="{StaticResource OverlayTextStyle}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="KODE VOUCHER" Style="{StaticResource FieldCaptionStyle}"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"
                              Stroke="#8A93A6" StrokeThickness="1.6"
                              Stretch="Uniform"
                              Width="20" Height="20"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="KodeTextBox" Grid.Column="1"
                                 Height="46" FontSize="16"
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="16,0" BorderThickness="1" BorderBrush="#2EFFFFFF"
                                 Background="{StaticResource FieldInsetBrush}"
                                 Foreground="White" CaretBrush="#00D4AA"
                                 Template="{StaticResource PillFieldTemplate}"/>
                    </Grid>

                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldCaptionStyle}"/>
                    <Grid Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M18,8h-1V6c0,-2.76 -2.24,-5 -5,-5S7,3.24 7,6v2H6c-1.1,0 -2,0.9 -2,2v10c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V10c0,-1.1 -0.9,-2 -2,-2zM12,17c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2zM15.1,8H8.9V6c0,-1.71 1.39,-3 3.1,-3s3.1,1.29 3.1,3v2z"
                              Stroke="#8A93A6" StrokeThickness="1.6"
                              Stretch="Uniform"
                              Width="20" Height="20"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="PasswordBox" Grid.Column="1"
                                     Height="46" FontSize="16"
                                     VerticalContentAlignment="Center" MaxLength="4"
                                     Padding="16,0" BorderThickness="1" BorderBrush="#2EFFFFFF"
                                     Background="{StaticResource FieldInsetBrush}"
                                     Foreground="White" CaretBrush="#00D4AA"
                                     Template="{StaticResource PillPasswordTemplate}"/>
                    </Grid>

                    <Button x:Name="LoginButton" 
                            Content="LOGIN" 
                            Height="50" 
                            FontSize="15" FontWeight="Bold"
                            Background="#00D4AA" 
                            Foreground="#0C1118" 
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LoginButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#00E8BB"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#00B8A0"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Background" Value="#2A3040"/>
                                        <Setter Property="Foreground" Value="#5A6478"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="ErrorText" 
                               Text="" 
                               FontSize="13" 
                               Foreground="#FF6B6B" 
                               HorizontalAlignment="Center" 
                               Margin="0,14,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>



            <!-- Technician PIN Dialog (hidden by default) -->
            <Border x:Name="PinDialog" 
                    Background="#E61E1E24" 
                    CornerRadius="16" 
                    Padding="32"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="MODE TEKNISI" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="#FFD700" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Masukkan PIN untuk akses desktop" 
                               FontSize="14" 
                               Foreground="#AAAAAA" 
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Button x:Name="OtpButton" Content="KIRIM OTP KE TELEGRAM" 
                            Width="220" Height="36"
                            Background="#1F7A8C" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,0,0,16" HorizontalAlignment="Center"
                            Click="OtpButton_Click"/>

                    <PasswordBox x:Name="PinBox" 
                                 Width="200" Height="40" FontSize="18" 
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="8,0" BorderThickness="1" BorderBrush="#444"
                                 Background="#111" Foreground="White" CaretBrush="#FFD700"
                                 HorizontalAlignment="Center"/>

                    <TextBlock x:Name="PinHintText" 
                               Text="" FontSize="13" Foreground="#FFD700"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="Collapsed"/>

                    <Button x:Name="StopAgentButton" Content="STOP AGENT (DARURAT)" 
                            Width="220" Height="40"
                            Background="#C62828" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,16,0,0" HorizontalAlignment="Center"
                            Visibility="Collapsed" Click="StopAgentButton_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="PinOkButton" Content="OK" Width="80" Height="36" 
                                Background="#FFD700" Foreground="#111" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0"
                                Click="PinOkButton_Click"/>
                        <Button x:Name="PinCancelButton" Content="BATAL" Width="80" Height="36" 
                                Background="#444" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                Click="PinCancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

            <!-- Dialog ganti password (hidden by default). Tampil dari mini window
                 saat sesi berjalan, bukan dari layar login. -->

        <!-- Mini countdown window (visible while session active, desktop usable) — gaya Uiverse (navy + gradient cyan) -->
        <Border x:Name="MiniPanel" 
                Background="#FF161A24" 
                CornerRadius="12" 
                BorderBrush="#3D00D4AA" BorderThickness="1"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="16"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#00D4AA"/>
            </Border.Effect>
            <StackPanel Width="300">
                <!-- Header: strip gradien cyan gaya Uiverse -->
                <Border CornerRadius="12,12,0,0" Padding="14,10,6,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#049FBB" Offset="0"/>
                            <GradientStop Color="#50F6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <TextBlock Text="V3 NETBILL — SESI AKTIF"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#1B233D"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="MinimizeMiniButton"
                                Content="&#x2013;"
                                Width="26" Height="26"
                                FontSize="16" FontWeight="Bold"
                                Background="#331B233D" Foreground="#1B233D"
                                BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Right"
                                Click="MinimizeMiniButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="mbd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="mbd" Property="Background" Value="#661B233D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border Background="#FF161A24" CornerRadius="0,0,12,12" Padding="14,14,14,14">
                    <StackPanel>
                        <!-- Baris utama: lingkaran tombol stop (gaya album-cover) + identitas -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lingkaran = tombol stop sesi -->
                            <Button x:Name="StopSesiButton"
                                    Grid.Column="0"
                                    Width="72" Height="72"
                                    Background="#FF5252"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTip="Hentikan sesi sekarang"
                                    Click="StopSesiButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="sbd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="36">
                                            <StackPanel VerticalAlignment="Center">
                                                <Path Data="M6,6h12v12h-12z"
                                                      Fill="White" Stretch="Uniform"
                                                      Width="20" Height="20"
                                                      HorizontalAlignment="Center"/>
                                                <TextBlock Text="STOP"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sbd" Property="Background" Value="#FF6B6B"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="sbd" Property="Background" Value="#D63232"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Judul (gaya song-title) + subjudul (gaya artist) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="AKUN"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#00D4AA"/>
                                <TextBlock Text="{Binding AkunLabel}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sisa waktu — tetap besar agar terbaca dari jauh.
                             Berpindah ke bawah karena lingkaran dipakai tombol stop. -->
                        <TextBlock Text="{Binding CountdownText}"
                                   FontSize="46" FontWeight="Bold"
                                   Foreground="#00D4AA"
                                   FontFamily="Consolas, Courier New, monospace"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>

                        <!-- Timeline 4px, warna ikut sisa waktu. Nilai tetap dari
                             ProgressPercent server, bukan animasi dekoratif. -->
                        <Border Height="4" CornerRadius="2" Background="#252B3D"
                                Margin="2,8,2,0" ClipToBounds="True">
                            <ProgressBar x:Name="MiniProgressBar"
                                         Style="{StaticResource TimelineStyle}"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"/>
                        </Border>

                        <!-- Ganti password: hanya muncul saat sesi berjalan, jadi
                             yang menekan memang sedang memakai komputer ini. -->
                        <Button x:Name="MiniGantiPasswordButton"
                                Content="GANTI PASSWORD"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                Click="BuatPasswordButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#6B7A94"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#00D4AA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Status / pesan error -->
                        <TextBlock x:Name="MiniStatusText"
                                   FontSize="12" Foreground="#FFD166"
                                   HorizontalAlignment="Center"
                                   Margin="2,8,2,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Akses mode teknisi (bypass overlay) — sengaja tanpa bentuk tombol, hanya
             teks samar di kiri bawah supaya tidak menarik perhatian user yang lewat.
             Tetap diklik untuk membuka dialog PIN. Dipakai teknisi remote via RustDesk. -->
        <Button x:Name="AdminPinButton"
                Content="maintenance"
                FontSize="11"
                Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,10"
                Click="AdminPinButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#45FFFFFF"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#99FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- Template minimal: template bawaan WPF bisa menggambar background
                 saat hover walau Background=Transparent, sehingga bentuk tombol
                 masih bisa terlihat. Template ini memastikan hanya teks yang tampil. -->
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border x:Name="BuatPasswordDialog"
                Background="#F21A1A22"
                CornerRadius="16"
                Padding="28,24"
                Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="GANTI PASSWORD"
                           FontSize="16" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <TextBlock Text="PASSWORD LAMA" Style="{StaticResource FieldCaptionStyle}"/>
                <PasswordBox x:Name="PasswordLamaBox"
                             Height="44" FontSize="15" MaxLength="12"
                             VerticalContentAlignment="Center"
                             Padding="14,0" BorderThickness="1" BorderBrush="#2EFFFFFF"
                             Background="{StaticResource FieldInsetBrush}"
                             Foreground="White" CaretBrush="#00D4AA"
                             Tag="0000"
                             Template="{StaticResource PillPasswordTemplate}"/>
                <TextBlock x:Name="PasswordLamaHint"
                           Text="Belum pernah ganti? Isi 0000"
                           FontSize="10"
                           Foreground="#6B7A94"
                           Margin="2,5,0,0"/>

                <TextBlock Text="PASSWORD BARU" Style="{StaticResource FieldCaptionStyle}" Margin="0,14,0,0"/>
                <PasswordBox x:Name="PasswordBaruBox"
                             Height="44" FontSize="15" MaxLength="12"
                             VerticalContentAlignment="Center"
                             Padding="14,0" BorderThickness="1" BorderBrush="#2EFFFFFF"
                             Background="{StaticResource FieldInsetBrush}"
                             Foreground="White" CaretBrush="#00D4AA"
                             Template="{StaticResource PillPasswordTemplate}"/>

                <TextBlock Text="ULANGI PASSWORD BARU" Style="{StaticResource FieldCaptionStyle}" Margin="0,14,0,0"/>
                <PasswordBox x:Name="PasswordUlangiBox"
                             Height="44" FontSize="15" MaxLength="12"
                             VerticalContentAlignment="Center"
                             Padding="14,0" BorderThickness="1" BorderBrush="#2EFFFFFF"
                             Background="{StaticResource FieldInsetBrush}"
                             Foreground="White" CaretBrush="#00D4AA"
                             Template="{StaticResource PillPasswordTemplate}"/>

                <TextBlock x:Name="BuatPasswordErrorText"
                           Text=""
                           FontSize="12"
                           Foreground="#FF6B6B"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button x:Name="BuatPasswordOkButton" Content="GANTI" Width="120" Height="40"
                            FontSize="13" FontWeight="Bold"
                            Background="#00D4AA" Foreground="#0C1118" BorderThickness="0"
                            Margin="0,0,10,0" Cursor="Hand" Click="BuatPasswordOkButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#00E8BB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="BuatPasswordCancelButton" Content="BATAL" Width="120" Height="40"
                            FontSize="13" FontWeight="Bold"
                            Background="#2A3040" Foreground="#C6CEDC" BorderThickness="0"
                            Cursor="Hand" Click="BuatPasswordCancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3A4256"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Window>