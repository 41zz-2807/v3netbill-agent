<Window x:Class="V3Netbill.Agent.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="v3Netbill Agent Overlay"
        Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowState="Normal"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Meniru box-shadow: inset 2px 5px 10px dari CSS Uiverse. WPF tidak punya
             inner shadow, jadi dipakai gradien yang lebih gelap di atas lalu memudar
             ke bawah. Satu elemen, tanpa Border bersarang. -->




        <!-- Gaya tombol aksi kartu mini — meniru kelas .pcc__act di dashboard web:
             32x32, radius 8, tanpa border. Foreground tidak diatur di sini supaya
             tiap tombol bisa memberi warna sendiri lewat atributnya.

             ⚠️ Background="Transparent" saja TIDAK cukup untuk menghilangkan bentuk
             tombol: template bawaan Aero2 punya trigger IsMouseOver di dalam
             ControlTemplate-nya sendiri yang menggambar background terang. Karena
             itu ControlTemplate dipasang (isi hanya Border + ContentPresenter).
             Jarak -1px saat hover meniru translateY(-1px) di CSS; scale() tidak
             dipakai karena ikon cuma 16px di dalam kotak 32px sehingga akan
             meleset dari tengah. -->
        <Style x:Key="AksiKartuStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template field berbentuk pil. PART_ContentHost wajib dipakai agar
             TextBox/PasswordBox tetap menjulkan teks dengan benar. -->
        <ControlTemplate x:Key="PillFieldTemplate" TargetType="TextBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="23">
                <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#00D4AA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>


    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Latar layar penuh. Warnanya fallback LIGHT, bukan hitam seperti
             sebelumnya: kalau wallpaper belum pernah diunggah lewat web, tema
             terang akan terlihat rusak kalau latarnya hitam pekat. -->
        <Border x:Name="OverlayBackground" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0FAFB" Offset="0"/>
                    <GradientStop Color="#E0F7FA" Offset="0.45"/>
                    <GradientStop Color="#FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Veil putih DI ATAS wallpaper. Tanpa ini, wallpaper gelap apa pun
             yang diunggah lewat web akan membuat layar tetap gelap while kartu
             putihnya tampak nempel. valued veil membuat gambar tetap terlihat
             tapi seluruh layar terasa light, sama seperti latar aplikasi web. -->
        <Border x:Name="WallpaperVeil"
                Background="#FFFFFFFF"
                Opacity="0.62"
                Visibility="Collapsed"/>

        <!-- Main content centered -->
        <StackPanel x:Name="ContentPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="420"
                    Visibility="Visible">

            <!-- Kartu login: panel putih radius 16 dengan header pastel cyan,
                 sama seperti kartu PC di aplikasi web. BorderBrush dipakai
                 supaya kartu tetap terlihat di atas wallpaper yang terang. -->
            <Border x:Name="LoginCard"
                    Background="#FFFFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="Visible">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.18" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Header pastel: logo + judul -->
                    <Border Background="#FFE0F7FA" CornerRadius="16,16,0,0" Padding="28,20">
                        <StackPanel>
                            <Image Source="/Assets/logo-v3netbill.png"
                                   Height="52"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                            <TextBlock Text="LOGIN VOUCHER / MEMBER"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="26,20,26,24">

                        <!-- Indikator koneksi ke server -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerStatus}" Value="connected">
                                                <Setter Property="Fill" Value="#16A34A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ServerStatus}" Value="disconnected">
                                                <Setter Property="Fill" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerStatusText}"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="KODE VOUCHER"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FieldCaptionStyle}"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"
                                  Stroke="#94A3B8"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  Width="20" Height="20"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="KodeTextBox" Grid.Column="1"
                                     Height="46" FontSize="16"
                                     VerticalContentAlignment="Center" MaxLength="6"
                                     Padding="16,0" BorderThickness="1" BorderBrush="#CBD5E1"
                                     Background="{StaticResource FieldInsetBrush}"
                                     Foreground="#0F172A" CaretBrush="#00B894"
                                     Template="{StaticResource PillFieldTemplate}"/>
                        </Grid>

                        <TextBlock Text="PASSWORD"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FieldCaptionStyle}"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M18,8h-1V6c0,-2.76 -2.24,-5 -5,-5S7,3.24 7,6v2H6c-1.1,0 -2,0.9 -2,2v10c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V10c0,-1.1 -0.9,-2 -2,-2zM12,17c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2zM15.1,8H8.9V6c0,-1.71 1.39,-3 3.1,-3s3.1,1.29 3.1,3v2z"
                                  Stroke="#94A3B8"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  Width="20" Height="20"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="1"
                                         Height="46" FontSize="16"
                                         VerticalContentAlignment="Center" MaxLength="4"
                                         Padding="16,0" BorderThickness="1" BorderBrush="#CBD5E1"
                                         Background="{StaticResource FieldInsetBrush}"
                                         Foreground="#0F172A" CaretBrush="#00B894"
                                         Template="{StaticResource PillPasswordTemplate}"/>
                        </Grid>

                        <Button x:Name="LoginButton"
                                Content="LOGIN"
                                Height="50"
                                FontSize="15" FontWeight="Bold"
                                Background="#00D4AA"
                                Foreground="#08312B"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="LoginButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#00E8BB"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#00B8A0"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="ErrorText"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#DC2626"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Technician PIN Dialog (hidden by default) -->
            <Border x:Name="PinDialog"
                    Background="#FFFFFFFF"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="16"
                    Padding="32"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="MODE TEKNISI"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#CA8A04"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Masukkan PIN untuk akses desktop"
                               FontSize="14"
                               Foreground="#64748B"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Button x:Name="OtpButton" Content="KIRIM OTP KE TELEGRAM"
                            Width="220" Height="36"
                            Background="#E0F7FA" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0"
                            Margin="0,0,0,16" HorizontalAlignment="Center"
                            Click="OtpButton_Click"/>

                    <PasswordBox x:Name="PinBox"
                                 Width="200" Height="40" FontSize="18"
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="8,0" BorderThickness="1" BorderBrush="#CBD5E1"
                                 Background="#FFFFFF" Foreground="#0F172A" CaretBrush="#CA8A04"
                                 HorizontalAlignment="Center"/>

                    <TextBlock x:Name="PinHintText"
                               Text="" FontSize="13" Foreground="#CA8A04"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="Collapsed"/>

                    <Button x:Name="StopAgentButton" Content="STOP AGENT (DARURAT)"
                            Width="220" Height="40"
                            Background="#C62828" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,16,0,0" HorizontalAlignment="Center"
                            Visibility="Collapsed" Click="StopAgentButton_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="PinOkButton" Content="OK" Width="80" Height="36"
                                Background="#CA8A04" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0"
                                Click="PinOkButton_Click"/>
                        <Button x:Name="PinCancelButton" Content="BATAL" Width="80" Height="36"
                                Background="#FFFFFF" Foreground="#334155" FontWeight="Bold" BorderThickness="1"
                                BorderBrush="#CBD5E1"
                                Click="PinCancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

            <!-- Dialog ganti password (hidden by default). Tampil dari mini window
                 saat sesi berjalan, bukan dari layar login. -->

<!-- Mini countdown window (visible while session active, desktop usable).
             Meniru kartu PC AKTIF di dashboard web (kelas .pcc): panel putih
             radius 16, header pastel #E0F7FA memuat hitung mundur + tombol aksi
             ikon, body putih memuat nama akun + Status/Tipe.
             Warna & ukuran diambil apa adanya dari frontend/src/index.css. -->
        <Border x:Name="MiniPanel"
                Background="#FFFFFFFF"
                CornerRadius="16"
                BorderBrush="#E2E8F0" BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Visibility="Collapsed">
            <!-- ⚠️ TIDAK pakai DropShadowEffect di sini. Di bawah RDP tanpa GPU
                 WPF memakai software rendering, dan BlurRadius tidak lagi
                 diburamai — ia tergambar sebagai KOTAK transparan berbali
                 tepat di sekeliling panel (terlihat di tangkapan layar kedua).
                 Batas 1px + warna kartu putih sudah cukup memisahkan panel dari
                 desktop, dan yang ini tidak bisa gagal merender jadi kotak. -->
            <StackPanel Width="300">
                <!-- ===== Header: hitung mundur kiri, tombol aksi kanan ===== -->
                <Border Background="#FFE0F7FA" CornerRadius="16,16,0,0"
                        Padding="18,16,14,14" MinHeight="90">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="SisaWaktuText"
                                       Text="{Binding CountdownText}"
                                       FontSize="32" FontWeight="Bold"
                                       FontFamily="Consolas, Courier New, monospace"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Style.Triggers>
                                            <!-- Sama dengan kelas .pcc__time (modifier warn) di dashboard web: <= 5 menit -->
                                            <DataTrigger Binding="{Binding SisaWaktuMenipis}" Value="True">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                            <!-- Diletakkan SETELAH penanda sisa waktu
                                                 supaya saat server tak terjangkau
                                                 angkanya jadi redup — bukan merah
                                                 "waktu mau habis", karena saat itu
                                                 angka itu memang tidak bergerak. -->
                                            <DataTrigger Binding="{Binding ServerTerputus}" Value="True">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LabelWaktuText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Style.Triggers>
                                            <!-- Server tak terjangkau: angka di atas
                                                 tidak lagi bergerak, dan itu wajib
                                                 terlihat. -->
                                            <DataTrigger Binding="{Binding ServerTerputus}" Value="True">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Minimalkan. Tombol ini tidak ada di kartu web, tapi
                                 agent butuh: inilah cara pengguna PC tetap bisa
                                 memakai desktop tanpa menutup panel. -->
                            <Button x:Name="MinimizeMiniButton"
                                    Style="{StaticResource AksiKartuStyle}"
                                    Background="#FFF1F5F9" Foreground="#64748B"
                                    ToolTip="Sembunyikan panel ini"
                                    Click="MinimizeMiniButton_Click">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M3,7.5 L10,7.5 L10,9 L3,9 Z"/>
                            </Button>

                            <!-- Ganti password: hanya tampil saat sesi berjalan,
                                 jadi yang menekan memang pemilik akun itu sendiri. -->
                            <Button x:Name="MiniGantiPasswordButton"
                                    Style="{StaticResource AksiKartuStyle}"
                                    Background="#FFCCFBF1" Foreground="#FF00B894"
                                    ToolTip="Ganti password akun ini"
                                    Click="BuatPasswordButton_Click">
                                <!-- Path "vpn_key" Material Design, diskalakan ke 16px -->
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M12.65,10 A5.99,5.99 0 0,0 7,6 H5 V4 H3 V2 H7 V4 H9 V6 H11.65 A6,6 0 0,0 11.65,16 Z M7,14 A2,2 0 1,1 9,12 A2,2 0 0,1 7,14 Z"/>
                            </Button>

                            <!-- Stop sesi. Warna merah memakai nilai kelas .pcc__act (modifier power). -->
                            <Button x:Name="StopSesiButton"
                                    Style="{StaticResource AksiKartuStyle}"
                                    Background="#FFFEE2E2" Foreground="#FFDC2626"
                                    ToolTip="Akhiri sesi sekarang"
                                    Click="StopSesiButton_Click">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M4,4 L12,4 L12,12 L4,12 Z"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Body: nama akun + Status/Tipe ===== -->
                <Border Background="#FFFFFFFF" CornerRadius="0,0,16,16" Padding="18,14,18,14">
                    <StackPanel>
                        <TextBlock Text="{Binding AkunIdentitas}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,12"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="STATUS" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="BERJALAN"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FF16A34A"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TIPE" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding AkunTipeLabel}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FF334155"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Status / pesan error. Default tersembunyi; kode di belakang menampilkannya
                             hanya sebentar saat ada yang perlu diberitahukan. -->
                        <TextBlock x:Name="MiniStatusText"
                                   FontSize="12" Foreground="#FFCA8A04"
                                   Margin="2,10,2,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Akses mode teknisi (bypass overlay) — sengaja tanpa bentuk tombol, hanya
             teks samar di kiri bawah supaya tidak menarik perhatian user yang lewat.
             Tetap diklik untuk membuka dialog PIN. Dipakai teknisi remote via RustDesk. -->
        <Button x:Name="AdminPinButton"
                Content="maintenance"
                FontSize="11"
                Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,10"
                Click="AdminPinButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#450F172A"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#990F172A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- Template minimal: template bawaan WPF bisa menggambar background
                 saat hover walau Background=Transparent, sehingga bentuk tombol
                 masih bisa terlihat. Template ini memastikan hanya teks yang tampil. -->
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>