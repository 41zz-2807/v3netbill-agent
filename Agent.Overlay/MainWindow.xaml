<Window x:Class="V3Netbill.Agent.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="v3Netbill Agent Overlay"
        Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowState="Normal"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="OverlayTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Fullscreen overlay background (visible when Locked) -->
        <Border x:Name="OverlayBackground" 
                Background="#CC000000" 
                Visibility="Collapsed"/>

        <!-- Main content centered -->
        <StackPanel x:Name="ContentPanel" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Width="420"
                    Visibility="Visible">
            
            <!-- Countdown Card (visible when Locked) -->
            <Border x:Name="CountdownCard" 
                    Background="#E61E1E24" 
                    CornerRadius="16" 
                    Padding="32" 
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="StatusText" 
                               Text="SESI BERJALAN" 
                               FontSize="22" FontWeight="SemiBold" 
                               Style="{StaticResource OverlayTextStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="CountdownText" 
                               Text="--:--" 
                               FontSize="80" FontWeight="Bold" 
                               Foreground="#00D4AA" 
                               HorizontalAlignment="Center"
                               FontFamily="Consolas, Courier New, monospace"/>
                    <TextBlock x:Name="SessionInfoText" 
                               Text="Sesi voucher/member aktif" 
                               FontSize="14" 
                               Foreground="#888888" 
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    
                    <!-- Progress bar -->
                    <ProgressBar x:Name="ProgressBar" 
                                 Height="6" 
                                 Margin="0,16,0,0"
                                 Background="#333333" 
                                 BorderThickness="0"
                                 Foreground="#00D4AA"
                                 Maximum="100"
                                 Value="0"/>
                </StackPanel>
            </Border>

            <!-- Login Card (visible when Unlocked) -->
            <Border x:Name="LoginCard" 
                    Background="#E61E1E24" 
                    CornerRadius="16" 
                    Padding="32"
                    Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="LOGIN VOUCHER / MEMBER" 
                               FontSize="18" FontWeight="SemiBold" 
                               Style="{StaticResource OverlayTextStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Kode:" Width="70" Style="{StaticResource OverlayTextStyle}" VerticalAlignment="Center" FontSize="15"/>
                        <TextBox x:Name="KodeTextBox" Width="280" Height="40" FontSize="16" 
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="8,0" BorderThickness="1" BorderBrush="#444"
                                 Background="#111" Foreground="White" CaretBrush="#00D4AA"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Password:" Width="70" Style="{StaticResource OverlayTextStyle}" VerticalAlignment="Center" FontSize="15"/>
                        <PasswordBox x:Name="PasswordBox" Width="280" Height="40" FontSize="16" 
                                     VerticalContentAlignment="Center" MaxLength="4"
                                     Padding="8,0" BorderThickness="1" BorderBrush="#444"
                                     Background="#111" Foreground="White" CaretBrush="#00D4AA"/>
                    </StackPanel>

                    <Button x:Name="LoginButton" 
                            Content="LOGIN" 
                            Height="48" 
                            FontSize="16" FontWeight="Bold"
                            Background="#00D4AA" 
                            Foreground="#111" 
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LoginButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#00E8BB"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#00B8A0"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Background" Value="#333333"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="ErrorText" 
                               Text="" 
                               FontSize="13" 
                               Foreground="#FF6B6B" 
                               HorizontalAlignment="Center" 
                               Margin="0,12,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Technician PIN Dialog (hidden by default) -->
            <Border x:Name="PinDialog" 
                    Background="#E61E1E24" 
                    CornerRadius="16" 
                    Padding="32"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="MODE TEKNISI" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="#FFD700" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Masukkan PIN untuk akses desktop" 
                               FontSize="14" 
                               Foreground="#AAAAAA" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <PasswordBox x:Name="PinBox" 
                                 Width="200" Height="40" FontSize="18" 
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="8,0" BorderThickness="1" BorderBrush="#444"
                                 Background="#111" Foreground="White" CaretBrush="#FFD700"
                                 HorizontalAlignment="Center"/>

                    <TextBlock x:Name="PinHintText" 
                               Text="" FontSize="13" Foreground="#FFD700"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="Collapsed"/>

                    <Button x:Name="StopAgentButton" Content="STOP AGENT (DARURAT)" 
                            Width="220" Height="40"
                            Background="#C62828" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,16,0,0" HorizontalAlignment="Center"
                            Visibility="Collapsed" Click="StopAgentButton_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="PinOkButton" Content="OK" Width="80" Height="36" 
                                Background="#FFD700" Foreground="#111" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0"
                                Click="PinOkButton_Click"/>
                        <Button x:Name="PinCancelButton" Content="BATAL" Width="80" Height="36" 
                                Background="#444" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                Click="PinCancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Mini countdown window (visible while session active, desktop usable) — gaya Uiverse (navy + gradient cyan) -->
        <Border x:Name="MiniPanel" 
                Background="#FF1B233D" 
                CornerRadius="16" 
                BorderBrush="#FF50F6FF" BorderThickness="1"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="16"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#049FBB"/>
            </Border.Effect>
            <StackPanel Width="300">
                <!-- Header: title di strip gradient cyan gaya Uiverse -->
                <Border CornerRadius="16,16,0,0" Padding="14,10,6,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#049FBB" Offset="0"/>
                            <GradientStop Color="#50F6FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <TextBlock Text="V3 NETBILL — SESI AKTIF"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#1B233D"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="MinimizeMiniButton"
                                Content="&#x2013;"
                                Width="26" Height="26"
                                FontSize="16" FontWeight="Bold"
                                Background="#331B233D" Foreground="#1B233D"
                                BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Right"
                                Click="MinimizeMiniButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="mbd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="mbd" Property="Background" Value="#661B233D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border Background="#FF1B233D" CornerRadius="0,0,16,16" Padding="14,10,14,12">
                    <StackPanel>
                        <!-- Identitas akun (voucher / member) — label kecil di atas nomor -->
                        <TextBlock Text="Akun" 
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#50F6FF"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0"/>

                        <!-- Nomor voucher / nama member (besar, jelas) -->
                        <TextBlock Text="{Binding AkunLabel}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="272"
                                   Margin="4,2,4,2"/>

                        <!-- Sisa waktu (countdown) -->
                        <TextBlock Text="{Binding CountdownText}"
                                   FontSize="46" FontWeight="Bold"
                                   Foreground="#50F6FF"
                                   FontFamily="Consolas, Courier New, monospace"
                                   HorizontalAlignment="Center"
                                   Margin="4,0,4,2"/>

                        <ProgressBar x:Name="MiniProgressBar"
                                     Height="5"
                                     Margin="6,0,6,8"
                                     Background="#28324E" BorderThickness="0"
                                     Foreground="#50F6FF"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent, Mode=OneWay}"/>

                        <!-- Tombol STOP SESI -->
                        <Button x:Name="StopSesiButton"
                                Content="STOP SESI"
                                Height="38"
                                FontSize="14" FontWeight="Bold"
                                Background="#FF5252" Foreground="#FFFFFF"
                                BorderThickness="0"
                                Margin="6,4,6,2"
                                Cursor="Hand"
                                Click="StopSesiButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="sbd" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="sbd" Property="Background" Value="#FF7A7A"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="sbd" Property="Background" Value="#D63232"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Pesan konfirmasi/status stop sesi -->
                        <TextBlock x:Name="MiniStatusText"
                                   FontSize="12" Foreground="#FFD166"
                                   HorizontalAlignment="Center"
                                   Margin="8,6,8,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Tombol Admin PIN — akses mode teknisi tanpa hotkey (aman remote via RustDesk) -->
        <Button x:Name="AdminPinButton"
                Content="Admin PIN"
                Width="110" Height="36"
                FontSize="12" FontWeight="SemiBold"
                Background="#66000000" Foreground="#AAAAAA"
                BorderThickness="1" BorderBrush="#33FFFFFF"
                Cursor="Hand"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,12"
                Click="AdminPinButton_Click"/>
    </Grid>
</Window>