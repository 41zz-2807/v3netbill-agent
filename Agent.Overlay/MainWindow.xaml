<Window x:Class="V3Netbill.Agent.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="v3Netbill Agent Overlay"
        Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowState="Normal"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Meniru box-shadow: inset 2px 5px 10px dari CSS Uiverse. WPF tidak punya
             inner shadow, jadi dipakai gradien yang lebih gelap di atas lalu memudar
             ke bawah. Satu elemen, tanpa Border bersarang. -->




        <!-- Timeline mini panel. Warnanya ikut sisa waktu: >60% hijau, 30-60% kuning,
             <=30% merah. Ketiganya mutually exclusive, jadi tidak saling tumpang tindih. -->
        <Style x:Key="TimelineStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2FBF71"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWaktuSedang}" Value="True">
                    <Setter Property="Foreground" Value="#F0B429"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWaktuKritis}" Value="True">
                    <Setter Property="Foreground" Value="#FF5252"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Template field berbentuk pil. PART_ContentHost wajib dipakai agar
             TextBox/PasswordBox tetap menjulkan teks dengan benar. -->
        <ControlTemplate x:Key="PillFieldTemplate" TargetType="TextBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="23">
                <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#00D4AA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>


    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Latar layar penuh. Warnanya fallback LIGHT, bukan hitam seperti
             sebelumnya: kalau wallpaper belum pernah diunggah lewat web, tema
             terang akan terlihat rusak kalau latarnya hitam pekat. -->
        <Border x:Name="OverlayBackground" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0FAFB" Offset="0"/>
                    <GradientStop Color="#E0F7FA" Offset="0.45"/>
                    <GradientStop Color="#FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Veil putih DI ATAS wallpaper. Tanpa ini, wallpaper gelap apa pun
             yang diunggah lewat web akan membuat layar tetap gelap while kartu
             putihnya tampak nempel. valued veil membuat gambar tetap terlihat
             tapi seluruh layar terasa light, sama seperti latar aplikasi web. -->
        <Border x:Name="WallpaperVeil"
                Background="#FFFFFFFF"
                Opacity="0.62"
                Visibility="Collapsed"/>

        <!-- Main content centered -->
        <StackPanel x:Name="ContentPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="420"
                    Visibility="Visible">

            <!-- Kartu login: panel putih radius 16 dengan header pastel cyan,
                 sama seperti kartu PC di aplikasi web. BorderBrush dipakai
                 supaya kartu tetap terlihat di atas wallpaper yang terang. -->
            <Border x:Name="LoginCard"
                    Background="#FFFFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="Visible">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.18" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Header pastel: logo + judul -->
                    <Border Background="#FFE0F7FA" CornerRadius="16,16,0,0" Padding="28,20">
                        <StackPanel>
                            <Image Source="/Assets/logo-v3netbill.png"
                                   Height="52"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                            <TextBlock Text="LOGIN VOUCHER / MEMBER"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="26,20,26,24">

                        <!-- Indikator koneksi ke server -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerStatus}" Value="connected">
                                                <Setter Property="Fill" Value="#16A34A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ServerStatus}" Value="disconnected">
                                                <Setter Property="Fill" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerStatusText}"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="KODE VOUCHER"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FieldCaptionStyle}"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M12,12c2.21,0 4,-1.79 4,-4s-1.79,-4 -4,-4 -4,1.79 -4,4 1.79,4 4,4zM12,14c-2.67,0 -8,1.34 -8,4v2h16v-2c0,-2.66 -5.33,-4 -8,-4z"
                                  Stroke="#94A3B8"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  Width="20" Height="20"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="KodeTextBox" Grid.Column="1"
                                     Height="46" FontSize="16"
                                     VerticalContentAlignment="Center" MaxLength="6"
                                     Padding="16,0" BorderThickness="1" BorderBrush="#CBD5E1"
                                     Background="{StaticResource FieldInsetBrush}"
                                     Foreground="#0F172A" CaretBrush="#00B894"
                                     Template="{StaticResource PillFieldTemplate}"/>
                        </Grid>

                        <TextBlock Text="PASSWORD"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource FieldCaptionStyle}"/>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M18,8h-1V6c0,-2.76 -2.24,-5 -5,-5S7,3.24 7,6v2H6c-1.1,0 -2,0.9 -2,2v10c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V10c0,-1.1 -0.9,-2 -2,-2zM12,17c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2zM15.1,8H8.9V6c0,-1.71 1.39,-3 3.1,-3s3.1,1.29 3.1,3v2z"
                                  Stroke="#94A3B8"
                                  StrokeThickness="1.6"
                                  Stretch="Uniform"
                                  Width="20" Height="20"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="PasswordBox" Grid.Column="1"
                                         Height="46" FontSize="16"
                                         VerticalContentAlignment="Center" MaxLength="4"
                                         Padding="16,0" BorderThickness="1" BorderBrush="#CBD5E1"
                                         Background="{StaticResource FieldInsetBrush}"
                                         Foreground="#0F172A" CaretBrush="#00B894"
                                         Template="{StaticResource PillPasswordTemplate}"/>
                        </Grid>

                        <Button x:Name="LoginButton"
                                Content="LOGIN"
                                Height="50"
                                FontSize="15" FontWeight="Bold"
                                Background="#00D4AA"
                                Foreground="#08312B"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="LoginButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#00E8BB"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#00B8A0"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="ErrorText"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#DC2626"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Technician PIN Dialog (hidden by default) -->
            <Border x:Name="PinDialog"
                    Background="#FFFFFFFF"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="16"
                    Padding="32"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="MODE TEKNISI"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#CA8A04"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Masukkan PIN untuk akses desktop"
                               FontSize="14"
                               Foreground="#64748B"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Button x:Name="OtpButton" Content="KIRIM OTP KE TELEGRAM"
                            Width="220" Height="36"
                            Background="#E0F7FA" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0"
                            Margin="0,0,0,16" HorizontalAlignment="Center"
                            Click="OtpButton_Click"/>

                    <PasswordBox x:Name="PinBox"
                                 Width="200" Height="40" FontSize="18"
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="8,0" BorderThickness="1" BorderBrush="#CBD5E1"
                                 Background="#FFFFFF" Foreground="#0F172A" CaretBrush="#CA8A04"
                                 HorizontalAlignment="Center"/>

                    <TextBlock x:Name="PinHintText"
                               Text="" FontSize="13" Foreground="#CA8A04"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="Collapsed"/>

                    <Button x:Name="StopAgentButton" Content="STOP AGENT (DARURAT)"
                            Width="220" Height="40"
                            Background="#C62828" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,16,0,0" HorizontalAlignment="Center"
                            Visibility="Collapsed" Click="StopAgentButton_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="PinOkButton" Content="OK" Width="80" Height="36"
                                Background="#CA8A04" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0"
                                Click="PinOkButton_Click"/>
                        <Button x:Name="PinCancelButton" Content="BATAL" Width="80" Height="36"
                                Background="#FFFFFF" Foreground="#334155" FontWeight="Bold" BorderThickness="1"
                                BorderBrush="#CBD5E1"
                                Click="PinCancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

            <!-- Dialog ganti password (hidden by default). Tampil dari mini window
                 saat sesi berjalan, bukan dari layar login. -->

        <!-- Mini countdown window (visible while session active, desktop usable) — gaya Uiverse (navy + gradient cyan) -->
        <Border x:Name="MiniPanel"
                Background="#FFFFFFFF"
                CornerRadius="16"
                BorderBrush="#E2E8F0" BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#0F172A"/>
            </Border.Effect>
            <StackPanel Width="300">
                <!-- Header: strip gradien cyan gaya Uiverse -->
                <Border Background="#FFE0F7FA" CornerRadius="16,16,0,0" Padding="16,12,8,12">
                    <Grid>
                        <TextBlock Text="V3 NETBILL — SESI AKTIF"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="MinimizeMiniButton"
                                Content="&#x2013;"
                                Width="26" Height="26"
                                FontSize="16" FontWeight="Bold"
                                Background="#FFFFFFFF" Foreground="#64748B"
                                BorderThickness="0" Cursor="Hand"
                                HorizontalAlignment="Right"
                                Click="MinimizeMiniButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="mbd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="mbd" Property="Background" Value="#E2E8F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border Background="#FFFFFFFF" CornerRadius="0,0,16,16" Padding="16,14,16,14">
                    <StackPanel>
                        <!-- Baris utama: lingkaran tombol stop (gaya album-cover) + identitas -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lingkaran = tombol stop sesi -->
                            <Button x:Name="StopSesiButton"
                                    Grid.Column="0"
                                    Width="72" Height="72"
                                    Background="#FF5252"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    ToolTip="Hentikan sesi sekarang"
                                    Click="StopSesiButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="sbd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="36">
                                            <StackPanel VerticalAlignment="Center">
                                                <Path Data="M6,6h12v12h-12z"
                                                      Fill="White" Stretch="Uniform"
                                                      Width="20" Height="20"
                                                      HorizontalAlignment="Center"/>
                                                <TextBlock Text="STOP"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sbd" Property="Background" Value="#FF6B6B"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="sbd" Property="Background" Value="#D63232"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Judul (gaya song-title) + subjudul (gaya artist) -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="AKUN"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#64748B"/>
                                <TextBlock Text="{Binding AkunLabel}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#0F172A"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sisa waktu — tetap besar agar terbaca dari jauh.
                             Berpindah ke bawah karena lingkaran dipakai tombol stop. -->
                        <TextBlock Text="{Binding CountdownText}"
                                   FontSize="46" FontWeight="Bold"
                                   Foreground="#0F172A"
                                   FontFamily="Consolas, Courier New, monospace"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>

                        <!-- Timeline 4px, warna ikut sisa waktu. Nilai tetap dari
                             ProgressPercent server, bukan animasi dekoratif. -->
                        <Border Height="4" CornerRadius="2" Background="#E2E8F0"
                                Margin="2,8,2,0" ClipToBounds="True">
                            <ProgressBar x:Name="MiniProgressBar"
                                         Style="{StaticResource TimelineStyle}"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"/>
                        </Border>

                        <!-- Ganti password: hanya muncul saat sesi berjalan, jadi
                             yang menekan memang sedang memakai komputer ini. -->
                        <Button x:Name="MiniGantiPasswordButton"
                                Content="GANTI PASSWORD"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"
                                Click="BuatPasswordButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#00B894"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Status / pesan error -->
                        <TextBlock x:Name="MiniStatusText"
                                   FontSize="12" Foreground="#CA8A04"
                                   HorizontalAlignment="Center"
                                   Margin="2,8,2,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Akses mode teknisi (bypass overlay) — sengaja tanpa bentuk tombol, hanya
             teks samar di kiri bawah supaya tidak menarik perhatian user yang lewat.
             Tetap diklik untuk membuka dialog PIN. Dipakai teknisi remote via RustDesk. -->
        <Button x:Name="AdminPinButton"
                Content="maintenance"
                FontSize="11"
                Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,10"
                Click="AdminPinButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#450F172A"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#990F172A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- Template minimal: template bawaan WPF bisa menggambar background
                 saat hover walau Background=Transparent, sehingga bentuk tombol
                 masih bisa terlihat. Template ini memastikan hanya teks yang tampil. -->
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>
</Window>