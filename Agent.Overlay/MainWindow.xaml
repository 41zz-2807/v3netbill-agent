<Window x:Class="V3Netbill.Agent.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="v3Netbill Agent Overlay"
        Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowState="Normal"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <Style x:Key="OverlayTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Fullscreen overlay background (visible when Locked) -->
        <Border x:Name="OverlayBackground" 
                Background="#CC000000" 
                Visibility="Collapsed"/>

        <!-- Main content centered -->
        <StackPanel x:Name="ContentPanel" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Width="420"
                    Visibility="Visible">
            
            <!-- Countdown Card (visible when Locked) -->
            <Border x:Name="CountdownCard" 
                    Background="#E61E1E24" 
                    CornerRadius="16" 
                    Padding="32" 
                    Margin="0,0,0,16"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="StatusText" 
                               Text="SESI BERJALAN" 
                               FontSize="22" FontWeight="SemiBold" 
                               Style="{StaticResource OverlayTextStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="CountdownText" 
                               Text="--:--" 
                               FontSize="80" FontWeight="Bold" 
                               Foreground="#00D4AA" 
                               HorizontalAlignment="Center"
                               FontFamily="Consolas, Courier New, monospace"/>
                    <TextBlock x:Name="SessionInfoText" 
                               Text="Sesi voucher/member aktif" 
                               FontSize="14" 
                               Foreground="#888888" 
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    
                    <!-- Progress bar -->
                    <ProgressBar x:Name="ProgressBar" 
                                 Height="6" 
                                 Margin="0,16,0,0"
                                 Background="#333333" 
                                 BorderThickness="0"
                                 Foreground="#00D4AA"
                                 Maximum="100"
                                 Value="0"/>
                </StackPanel>
            </Border>

            <!-- Login Card (visible when Unlocked) -->
            <Border x:Name="LoginCard" 
                    Background="#E61E1E24" 
                    CornerRadius="16" 
                    Padding="32"
                    Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="LOGIN VOUCHER / MEMBER" 
                               FontSize="18" FontWeight="SemiBold" 
                               Style="{StaticResource OverlayTextStyle}"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Kode:" Width="70" Style="{StaticResource OverlayTextStyle}" VerticalAlignment="Center" FontSize="15"/>
                        <TextBox x:Name="KodeTextBox" Width="280" Height="40" FontSize="16" 
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="8,0" BorderThickness="1" BorderBrush="#444"
                                 Background="#111" Foreground="White" CaretBrush="#00D4AA"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Password:" Width="70" Style="{StaticResource OverlayTextStyle}" VerticalAlignment="Center" FontSize="15"/>
                        <PasswordBox x:Name="PasswordBox" Width="280" Height="40" FontSize="16" 
                                     VerticalContentAlignment="Center" MaxLength="4"
                                     Padding="8,0" BorderThickness="1" BorderBrush="#444"
                                     Background="#111" Foreground="White" CaretBrush="#00D4AA"/>
                    </StackPanel>

                    <Button x:Name="LoginButton" 
                            Content="LOGIN" 
                            Height="48" 
                            FontSize="16" FontWeight="Bold"
                            Background="#00D4AA" 
                            Foreground="#111" 
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LoginButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#00E8BB"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#00B8A0"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Background" Value="#333333"/>
                                        <Setter Property="Foreground" Value="#666"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="ErrorText" 
                               Text="" 
                               FontSize="13" 
                               Foreground="#FF6B6B" 
                               HorizontalAlignment="Center" 
                               Margin="0,12,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Technician PIN Dialog (hidden by default) -->
            <Border x:Name="PinDialog" 
                    Background="#E61E1E24" 
                    CornerRadius="16" 
                    Padding="32"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="MODE TEKNISI" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="#FFD700" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Masukkan PIN untuk akses desktop" 
                               FontSize="14" 
                               Foreground="#AAAAAA" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <PasswordBox x:Name="PinBox" 
                                 Width="200" Height="40" FontSize="18" 
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="8,0" BorderThickness="1" BorderBrush="#444"
                                 Background="#111" Foreground="White" CaretBrush="#FFD700"
                                 HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="PinOkButton" Content="OK" Width="80" Height="36" 
                                Background="#FFD700" Foreground="#111" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0"
                                Click="PinOkButton_Click"/>
                        <Button x:Name="PinCancelButton" Content="BATAL" Width="80" Height="36" 
                                Background="#444" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                Click="PinCancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Mini countdown chip (visible while session active, desktop usable) -->
        <Border x:Name="MiniPanel" 
                Background="#E61E1E24" 
                CornerRadius="12" 
                Padding="16,10"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="16"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="SISA WAKTU" 
                           FontSize="12" FontWeight="SemiBold" 
                           Foreground="#00D4AA"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding CountdownText}" 
                           FontSize="28" FontWeight="Bold" 
                           Foreground="White"
                           FontFamily="Consolas, Courier New, monospace"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>