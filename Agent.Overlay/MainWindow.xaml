<Window x:Class="V3Netbill.Agent.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="v3Netbill Agent Overlay"
        Height="450" Width="800"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowState="Normal"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Meniru box-shadow: inset 2px 5px 10px dari CSS Uiverse. WPF tidak punya
             inner shadow, jadi dipakai gradien yang lebih gelap di atas lalu memudar
             ke bawah. Satu elemen, tanpa Border bersarang. -->




        <!-- Gaya tombol aksi kartu mini — meniru kelas .pcc__act di dashboard web:
             32x32, radius 8, tanpa border. Foreground tidak diatur di sini supaya
             tiap tombol bisa memberi warna sendiri lewat atributnya.

             ⚠️ Background="Transparent" saja TIDAK cukup untuk menghilangkan bentuk
             tombol: template bawaan Aero2 punya trigger IsMouseOver di dalam
             ControlTemplate-nya sendiri yang menggambar background terang. Karena
             itu ControlTemplate dipasang (isi hanya Border + ContentPresenter).
             Jarak -1px saat hover meniru translateY(-1px) di CSS; scale() tidak
             dipakai karena ikon cuma 16px di dalam kotak 32px sehingga akan
             meleset dari tengah. -->
        <Style x:Key="AksiKartuStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="-1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template field berbentuk pil. PART_ContentHost wajib dipakai agar
             TextBox/PasswordBox tetap menjulkan teks dengan benar. -->
        <ControlTemplate x:Key="PillFieldTemplate" TargetType="TextBox">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="23">
                <ScrollViewer x:Name="PART_ContentHost"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="#00D4AA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>


    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Latar layar penuh. Warnanya fallback LIGHT, bukan hitam seperti
             sebelumnya: kalau wallpaper belum pernah diunggah lewat web, tema
             terang akan terlihat rusak kalau latarnya hitam pekat. -->
        <Border x:Name="OverlayBackground" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0FAFB" Offset="0"/>
                    <GradientStop Color="#E0F7FA" Offset="0.45"/>
                    <GradientStop Color="#FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ⚠️ VEIL PUTIH DI ATAS WALLPAPER SUDAH DIHAPUS (2 Okt 2026).
             Dulu ada Border putih Opacity="0.62" di sini supaya kartu putih
             tidak terlihat seperti tempelan di atas wallpaper gelap. Kelemahannya
             jauh lebih besar dari kegunaannya: wallpaper jadi tampil sekitar
             40 persen saja, jadioperator tidak bisa melihat layar PC.

             Wallpaper sekarang tampil 100 persen apa adanya. Kartu putih di
             atasnya punya border 1px slate, jadi tetap terbatas dari wallpaper
             dan tidak "tempel". Kalau nanti kartu putih ternyata sulit dibaca
             di wallpaper tertentu, penanganannya StyledBorder kartu —
             bukan membuat seluruh layar pucat lagi.

             WallpaperVeil dan SinkronkanVeil() di MainWindow.xaml.cs ikut
             dibuang supaya tidak ada elemen tak terpakai yang menggantung. -->

        <!-- Main content centered -->
        <StackPanel x:Name="ContentPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="420"
                    Visibility="Visible">

            <!-- Kartu login mengikuti mockup "form_login_webdanpc.jpg": panel putih
                 dengan cincin putih dan radius besar. BorderBrush dipakai supaya
                 kartu tetap terlihat di atas wallpaper yang terang.

                 Radius 28 untuk lebar 420 = 6,7% — hasil mengukur mockup
                 (jari-jari sekitar 167px pada kartu selebar 2435px). Radius
                 lama 16 terlihat jauh lebih kotak dari mockup. -->
            <Border x:Name="LoginCard"
                    Background="#F2F5F7FA"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="28"
                    Visibility="Visible">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.18" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Header: logo + judul. Judul memakai gaya mockup — kapital dengan
                   jarak antar huruf lebar, bukan tebal. Isinya "LOGIN" saja
                   supaya sama dengan halaman web; field di bawahnya yang
                   menjelaskan ini kode voucher/member, lewat teks
                   placeholder-nya. -->
                  <Border Background="#FFFFFFFF" CornerRadius="28,28,0,0" Padding="28,26">
                      <StackPanel>
                          <Image Source="/Assets/logo-v3netbill.png"
                                 Height="46"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,14"/>
                          <TextBlock Text="LOGIN"
                                     FontSize="19"
                                     FontWeight="Normal"
                                     Foreground="#1E293B"
                                     HorizontalAlignment="Center">
                              <TextBlock.LayoutTransform>
                                  <ScaleTransform ScaleX="1.2"/>
                              </TextBlock.LayoutTransform>
                          </TextBlock>
                      </StackPanel>
                  </Border>

                    <StackPanel Margin="26,20,26,24">

                        <!-- Indikator koneksi ke server -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerStatus}" Value="connected">
                                                <Setter Property="Fill" Value="#16A34A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ServerStatus}" Value="disconnected">
                                                <Setter Property="Fill" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerStatusText}"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Field gaya mockup: ikon kiri + teks + garis bawah. Garis bawah
                 digambar Border pembungkus, BUKAN border WPF — template
                 di App.xaml sengaja mengosongkan border built-in.

                 ⚠️ Watermark memakai DataTrigger Text="" supaya teks
                 placeholder hilang begitu ada isian. Tanpa itu, placeholder
                 dan teks yang diketik akan bertumpuk di atas satu sama lain. -->
                  <Border BorderBrush="#CBD5E1" BorderThickness="0,0,0,2"
                          Padding="0,6,0,2" Margin="0,20,0,0">
                      <Grid>
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="38"/>
                              <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <!-- Ikon amplop (sama dengan di halaman web) -->
                          <Path Grid.Column="0"
                                Data="M3,6 L21,6 A2,2 0 0 1 23,8 L23,16 A2,2 0 0 1 21,18 L3,18 A2,2 0 0 1 1,16 L1,8 A2,2 0 0 1 3,6 Z M2,7 L12,14 L22,7"
                                Stroke="#64748B" StrokeThickness="1.6"
                                Stretch="Uniform" Width="19" Height="19"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                          <Grid Grid.Column="1">
                              <TextBox x:Name="KodeTextBox"
                                       FontSize="15"
                                       VerticalContentAlignment="Center" MaxLength="6"
                                       Padding="0" BorderThickness="0"
                                       Background="Transparent"
                                       Foreground="#0F172A" CaretBrush="#0D9488"
                                       Template="{StaticResource UnderlineFieldTemplate}"/>
                              <!-- Watermark dikendalikan dari code-behind, bukan
                                   DataTrigger. Lihat CatatanWatermark di
                                   MainWindow.xaml.cs. -->
                              <TextBlock x:Name="KodeWatermark"
                                         Text="KODE VOUCHER / MEMBER"
                                         IsHitTestVisible="False"
                                         FontSize="15"
                                         Foreground="#94A3B8"
                                         VerticalAlignment="Center"/>
                          </Grid>
                      </Grid>
                  </Border>

                        <Border BorderBrush="#CBD5E1" BorderThickness="0,0,0,2"
                          Padding="0,6,0,2" Margin="0,20,0,0">
                      <Grid>
                          <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="38"/>
                              <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Path Grid.Column="0"
                                Data="M18,8h-1V6c0,-2.76 -2.24,-5 -5,-5S7,3.24 7,6v2H6c-1.1,0 -2,0.9 -2,2v10c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V10c0,-1.1 -0.9,-2 -2,-2zM12,17c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2zM15.1,8H8.9V6c0,-1.71 1.39,-3 3.1,-3s3.1,1.29 3.1,3v2z"
                                Stroke="#64748B" StrokeThickness="1.6"
                                Stretch="Uniform" Width="19" Height="19"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                          <Grid Grid.Column="1">
                              <PasswordBox x:Name="PasswordBox"
                                           FontSize="15"
                                           VerticalContentAlignment="Center" MaxLength="4"
                                           Padding="0" BorderThickness="0"
                                           Background="Transparent"
                                           Foreground="#0F172A" CaretBrush="#0D9488"
                                           Template="{StaticResource UnderlinePasswordTemplate}"/>
                              <TextBlock x:Name="PasswordWatermark"
                                         Text="PASSWORD"
                                         IsHitTestVisible="False"
                                         FontSize="15"
                                         Foreground="#94A3B8"
                                         VerticalAlignment="Center"/>
                          </Grid>
                      </Grid>
                  </Border>

                        <!-- Tombol gaya mockup: pil gelap, huruf kapital, jarak antar
                                   huruf lebar. Aksen teal lama dipakai untuk
                                   fokus field (CaretBrush + garis bawah),
                                   bukan lagi untuk tombol — kalau dua-duanya
                                   dipakai, tombol tidak lagi jadi satu-satunya
                                   hal yang gelap di kartu. -->
                          <Button x:Name="LoginButton"
                                  Content="LOGIN"
                                  Height="48"
                                  Margin="0,30,0,0"
                                  FontSize="14" FontWeight="SemiBold"
                                  Background="#1E293B"
                                  Foreground="#FFFFFF"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  Click="LoginButton_Click">
                              <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                      <Border x:Name="bd"
                                              Background="{TemplateBinding Background}"
                                              CornerRadius="24">
                                          <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                              <ContentPresenter.LayoutTransform>
                                                  <ScaleTransform ScaleX="1.15"/>
                                              </ContentPresenter.LayoutTransform>
                                          </ContentPresenter>
                                      </Border>
                                      <ControlTemplate.Triggers>
                                          <Trigger Property="IsMouseOver" Value="True">
                                              <Setter TargetName="bd" Property="Background" Value="#0F172A"/>
                                          </Trigger>
                                          <Trigger Property="IsPressed" Value="True">
                                              <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                          </Trigger>
                                          <Trigger Property="IsEnabled" Value="False">
                                              <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                              <Setter Property="Foreground" Value="#94A3B8"/>
                                          </Trigger>
                                      </ControlTemplate.Triggers>
                                  </ControlTemplate>
                              </Button.Template>
                          </Button>

                        <TextBlock x:Name="ErrorText"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#DC2626"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Technician PIN Dialog (hidden by default) -->
            <Border x:Name="PinDialog"
                    Background="#FFFFFFFF"
                    BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="16"
                    Padding="32"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="MODE TEKNISI"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#CA8A04"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Masukkan PIN untuk akses desktop"
                               FontSize="14"
                               Foreground="#64748B"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Button x:Name="OtpButton" Content="KIRIM OTP KE TELEGRAM"
                            Width="220" Height="36"
                            Background="#E0F7FA" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0"
                            Margin="0,0,0,16" HorizontalAlignment="Center"
                            Click="OtpButton_Click"/>

                    <PasswordBox x:Name="PinBox"
                                 Width="200" Height="40" FontSize="18"
                                 VerticalContentAlignment="Center" MaxLength="6"
                                 Padding="8,0" BorderThickness="1" BorderBrush="#CBD5E1"
                                 Background="#FFFFFF" Foreground="#0F172A" CaretBrush="#CA8A04"
                                 HorizontalAlignment="Center"/>

                    <TextBlock x:Name="PinHintText"
                               Text="" FontSize="13" Foreground="#CA8A04"
                               HorizontalAlignment="Center" Margin="0,10,0,0"
                               Visibility="Collapsed"/>

                    <Button x:Name="StopAgentButton" Content="STOP AGENT (DARURAT)"
                            Width="220" Height="40"
                            Background="#C62828" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,16,0,0" HorizontalAlignment="Center"
                            Visibility="Collapsed" Click="StopAgentButton_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="PinOkButton" Content="OK" Width="80" Height="36"
                                Background="#CA8A04" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,12,0"
                                Click="PinOkButton_Click"/>
                        <Button x:Name="PinCancelButton" Content="BATAL" Width="80" Height="36"
                                Background="#FFFFFF" Foreground="#334155" FontWeight="Bold" BorderThickness="1"
                                BorderBrush="#CBD5E1"
                                Click="PinCancelButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

            <!-- Dialog ganti password (hidden by default). Tampil dari mini window
                 saat sesi berjalan, bukan dari layar login. -->

<!-- Mini countdown window (visible while session active, desktop usable).
             Meniru kartu PC AKTIF di dashboard web (kelas .pcc): panel putih
             radius 16, header pastel #E0F7FA memuat hitung mundur + tombol aksi
             ikon, body putih memuat nama akun + Status/Tipe.
             Warna & ukuran diambil apa adanya dari frontend/src/index.css. -->
        <Border x:Name="MiniPanel"
                Background="#FFFFFFFF"
                CornerRadius="16"
                BorderBrush="#E2E8F0" BorderThickness="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Visibility="Collapsed">
            <!-- ⚠️ TIDAK pakai DropShadowEffect di sini. Di bawah RDP tanpa GPU
                 WPF memakai software rendering, dan BlurRadius tidak lagi
                 diburamai — ia tergambar sebagai KOTAK transparan berbali
                 tepat di sekeliling panel (terlihat di tangkapan layar kedua).
                 Batas 1px + warna kartu putih sudah cukup memisahkan panel dari
                 desktop, dan yang ini tidak bisa gagal merender jadi kotak. -->
            <StackPanel Width="300">
                <!-- ===== Header: hitung mundur kiri, tombol aksi kanan ===== -->
                <Border Background="#FFE0F7FA" CornerRadius="16,16,0,0"
                        Padding="18,16,14,14" MinHeight="90">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock x:Name="SisaWaktuText"
                                       Text="{Binding CountdownText}"
                                       FontSize="34" FontWeight="Bold"
                                       FontFamily="Consolas, Courier New, monospace"
                                       TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Style.Triggers>
                                            <!-- Sama dengan kelas warn di dashboard web: <= 5 menit -->
                                            <DataTrigger Binding="{Binding SisaWaktuMenipis}" Value="True">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                            <!-- ⚠️ JANGAN pernah dijadikan pucat saat server
                                                 terputus. Angka itu justru satu-satunya
                                                 informasi yang dicari orang, dan warna pucat
                                                 di atas header pastel membuat praktis tak
                                                 terbaca (dilaporkan 2 Okt 2026). Server
                                                 terputus ditandai oleh TEKS MERAH di
                                                 bawahnya, bukan dengan memudarnya angka. -->
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LabelWaktuText}"
                                       FontSize="11" FontWeight="Bold"
                                       Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerTerputus}" Value="True">
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Minimalkan. Tombol ini tidak ada di kartu web, tapi
                                 agent butuh: inilah cara pengguna PC tetap bisa
                                 memakai desktop tanpa menutup panel. -->
                            <Button x:Name="MinimizeMiniButton"
                                    Style="{StaticResource AksiKartuStyle}"
                                    Background="#FFF1F5F9" Foreground="#64748B"
                                    ToolTip="Sembunyikan panel ini"
                                    Click="MinimizeMiniButton_Click">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M3,7.5 L10,7.5 L10,9 L3,9 Z"/>
                            </Button>

                            <!-- Ganti password: hanya tampil saat sesi berjalan,
                                 jadi yang menekan memang pemilik akun itu sendiri. -->
                            <Button x:Name="MiniGantiPasswordButton"
                                    Style="{StaticResource AksiKartuStyle}"
                                    Background="#FFCCFBF1" Foreground="#FF00B894"
                                    ToolTip="Ganti password akun ini"
                                    Click="BuatPasswordButton_Click">
                                <!-- Gembok + lubang kunci. Path "lock" Material
                                     Design (24x24) yang diskalakan ke 16px.
                                     Percobaan pertama memakai ikon "vpn_key"
                                     (gembok + anak kunci) dan bentuknya
                                     menyatu jadi gumpalan di 16px — dilaporkan
                                     2 Okt 2026 sebagai "tidak jelas gambarnya". -->
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M18,8h-1V6c0,-2.76 -2.24,-5 -5,-5S7,3.24 7,6v2H6c-1.1,0 -2,0.9 -2,2v10c0,1.1 0.9,2 2,2h12c1.1,0 2,-0.9 2,-2V10c0,-1.1 -0.9,-2 -2,-2zM9,6c0,-1.66 1.34,-3 3,-3s3,1.34 3,3v2H9V6zM12,17c-1.1,0 -2,-0.9 -2,-2s0.9,-2 2,-2 2,0.9 2,2 -0.9,2 -2,2z"/>
                            </Button>

                            <!-- Stop sesi. Warna merah memakai nilai kelas .pcc__act (modifier power). -->
                            <Button x:Name="StopSesiButton"
                                    Style="{StaticResource AksiKartuStyle}"
                                    Background="#FFFEE2E2" Foreground="#FFDC2626"
                                    ToolTip="Akhiri sesi sekarang"
                                    Click="StopSesiButton_Click">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      Data="M4,4 L12,4 L12,12 L4,12 Z"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Body: nama akun + Status/Tipe ===== -->
                <Border Background="#FFFFFFFF" CornerRadius="0,0,16,16" Padding="18,14,18,14">
                    <StackPanel>
                        <TextBlock Text="{Binding AkunIdentitas}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,12"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="STATUS" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="BERJALAN"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FF16A34A"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TIPE" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding AkunTipeLabel}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FF334155"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Status / pesan error. Default tersembunyi; kode di belakang menampilkannya
                             hanya sebentar saat ada yang perlu diberitahukan. -->
                        <TextBlock x:Name="MiniStatusText"
                                   FontSize="12" Foreground="#FFCA8A04"
                                   Margin="2,10,2,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Akses mode teknisi (bypass overlay) — sengaja tanpa bentuk tombol, hanya
             teks samar di kiri bawah supaya tidak menarik perhatian user yang lewat.
             Tetap diklik untuk membuka dialog PIN. Dipakai teknisi remote via RustDesk. -->
        <Button x:Name="AdminPinButton"
                Content="maintenance"
                FontSize="11"
                Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,10"
                Click="AdminPinButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#450F172A"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#990F172A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <!-- Template minimal: template bawaan WPF bisa menggambar background
                 saat hover walau Background=Transparent, sehingga bentuk tombol
                 masih bisa terlihat. Template ini memastikan hanya teks yang tampil. -->
            <Button.Template>
                <ControlTemplate TargetType="Button">
