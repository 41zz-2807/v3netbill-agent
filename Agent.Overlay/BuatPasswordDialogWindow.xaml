<!-- Dialog ganti password.
     Sengaja dibuat sebagai jendela terpisah, bukan Border di dalam MainWindow. Waktu sesi
     berjalan MainWindow menyusut jadi 340x268, jadi dialog yang ditumpuk di sana
     akan keluar dari tepi jendela: kolom ulangan password dan tombolnya
     terpotong, dan karena ResizeMode=NoResize pengguna tidak bisa membesar
     atau menutupnya. Jendela terpisah ukurannya menyesuaikan sendiri dan tidak tersentuh
     oleh UpdateWindowState(). -->
<Window x:Class="V3Netbill.Agent.Overlay.BuatPasswordDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ganti Password"
        Width="368"
        WindowStyle="None"
        AllowsTransparency="True"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <!-- Panel putih + header pastel, sama seperti kartu PC di web.
         WindowStyle=None di atas wajib: kalau tidak, Windows menggambar
         caption bar sendiri dan muncul dua tombol X — yang bawaan dan yang
         di header ini. -->
    <Border Background="#FFFFFFFF"
            BorderBrush="#E2E8F0" BorderThickness="1"
            CornerRadius="16" Margin="24,20">
    <Border.Effect>
        <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.18" Color="#0F172A"/>
    </Border.Effect>
    <Grid>
        <StackPanel>
            <Grid Margin="26,18,26,16">
                <TextBlock Text="GANTI PASSWORD"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>
                <Button Content="&#x2715;"
                        Width="28" Height="28" FontSize="12" FontWeight="Bold"
                        Background="#FFFFFFFF" Foreground="#64748B"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Tutup (Esc)"
                        IsCancel="True"/>
            </Grid>

            <TextBlock Text="PASSWORD LAMA" Style="{StaticResource FieldCaptionStyle}"/>
            <PasswordBox x:Name="PasswordLamaBox"
                         Height="44" FontSize="15" MaxLength="12"
                         VerticalContentAlignment="Center"
                         Padding="14,0" BorderThickness="1" BorderBrush="#CBD5E1"
                         Background="{StaticResource FieldInsetBrush}"
                         Foreground="#0F172A" CaretBrush="#00B894"
                         Template="{StaticResource PillPasswordTemplate}"/>
            <TextBlock Text="Belum pernah ganti? Isi 0000"
                       FontSize="10"
                       Foreground="#64748B"
                       Margin="2,5,0,0"/>

            <TextBlock Text="PASSWORD BARU" Style="{StaticResource FieldCaptionStyle}" Margin="0,14,0,0"/>
            <PasswordBox x:Name="PasswordBaruBox"
                         Height="44" FontSize="15" MaxLength="12"
                         VerticalContentAlignment="Center"
                         Padding="14,0" BorderThickness="1" BorderBrush="#CBD5E1"
                         Background="{StaticResource FieldInsetBrush}"
                         Foreground="#0F172A" CaretBrush="#00B894"
                         Template="{StaticResource PillPasswordTemplate}"/>

            <TextBlock Text="ULANGI PASSWORD BARU" Style="{StaticResource FieldCaptionStyle}" Margin="0,14,0,0"/>
            <PasswordBox x:Name="PasswordUlangiBox"
                         Height="44" FontSize="15" MaxLength="12"
                         VerticalContentAlignment="Center"
                         Padding="14,0" BorderThickness="1" BorderBrush="#CBD5E1"
                         Background="{StaticResource FieldInsetBrush}"
                         Foreground="#0F172A" CaretBrush="#00B894"
                         Template="{StaticResource PillPasswordTemplate}"/>

            <TextBlock x:Name="ErrorText"
                       Text=""
                       FontSize="12"
                       Foreground="#DC2626"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="OkButton" Content="GANTI" Width="120" Height="40"
                        FontSize="13" FontWeight="Bold"
                        Background="#00D4AA" Foreground="#08312B" BorderThickness="0"
                        Margin="0,0,10,0" Cursor="Hand"
                        IsDefault="True"
                        Click="OkButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#00E8BB"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Atribut IsCancel sengaja TIDAK dipakai di sini: header sudah
                     punya satu tombol yang itu (penyebabnya Escape menutup
                     dialog). Dua IsCancel dalam satu Window membuat perilaku
                     Escape ambigu — yang terdaftar terakhir bisa menang. Tombol
                     ini tetap berfungsi lewat Click-nya. -->
                <Button x:Name="BatalButton" Content="BATAL" Width="120" Height="40"
                        FontSize="13" FontWeight="Bold"
                        Background="#FFFFFFFF" Foreground="#334155"
                        BorderBrush="#CBD5E1" BorderThickness="1"
                        Cursor="Hand"
                        Click="CancelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A4256"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
    </Border>
</Window>
