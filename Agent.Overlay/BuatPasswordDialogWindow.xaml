<!-- Dialog ganti password.
     Sengaja dibuat sebagai jendela terpisah, bukan Border di dalam MainWindow. Waktu sesi
     berjalan MainWindow menyusut jadi 340x268, jadi dialog yang ditumpuk di sana
     akan keluar dari tepi jendela: kolom ulangan password dan tombolnya
     terpotong, dan karena ResizeMode=NoResize pengguna tidak bisa membesar
     atau menutupnya. Jendela terpisah ukurannya menyesuaikan sendiri dan tidak tersentuh
     oleh UpdateWindowState(). -->
<Window x:Class="V3Netbill.Agent.Overlay.BuatPasswordDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ganti Password"
        Width="368"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#F21A1A22"
        FontFamily="Segoe UI">

    <Grid Margin="24,20">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <TextBlock Text="GANTI PASSWORD"
                           FontSize="16" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="&#x2715;"
                        Width="26" Height="26" FontSize="13" FontWeight="Bold"
                        Background="#2A3040" Foreground="#C6CEDC"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Tutup (Esc)"
                        IsCancel="True"/>
            </Grid>

            <TextBlock Text="PASSWORD LAMA" Style="{StaticResource FieldCaptionStyle}"/>
            <PasswordBox x:Name="PasswordLamaBox"
                         Height="44" FontSize="15" MaxLength="12"
                         VerticalContentAlignment="Center"
                         Padding="14,0" BorderThickness="1" BorderBrush="#2EFFFFFF"
                         Background="{StaticResource FieldInsetBrush}"
                         Foreground="White" CaretBrush="#00D4AA"
                         Template="{StaticResource PillPasswordTemplate}"/>
            <TextBlock Text="Belum pernah ganti? Isi 0000"
                       FontSize="10"
                       Foreground="#6B7A94"
                       Margin="2,5,0,0"/>

            <TextBlock Text="PASSWORD BARU" Style="{StaticResource FieldCaptionStyle}" Margin="0,14,0,0"/>
            <PasswordBox x:Name="PasswordBaruBox"
                         Height="44" FontSize="15" MaxLength="12"
                         VerticalContentAlignment="Center"
                         Padding="14,0" BorderThickness="1" BorderBrush="#2EFFFFFF"
                         Background="{StaticResource FieldInsetBrush}"
                         Foreground="White" CaretBrush="#00D4AA"
                         Template="{StaticResource PillPasswordTemplate}"/>

            <TextBlock Text="ULANGI PASSWORD BARU" Style="{StaticResource FieldCaptionStyle}" Margin="0,14,0,0"/>
            <PasswordBox x:Name="PasswordUlangiBox"
                         Height="44" FontSize="15" MaxLength="12"
                         VerticalContentAlignment="Center"
                         Padding="14,0" BorderThickness="1" BorderBrush="#2EFFFFFF"
                         Background="{StaticResource FieldInsetBrush}"
                         Foreground="White" CaretBrush="#00D4AA"
                         Template="{StaticResource PillPasswordTemplate}"/>

            <TextBlock x:Name="ErrorText"
                       Text=""
                       FontSize="12"
                       Foreground="#FF6B6B"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="OkButton" Content="GANTI" Width="120" Height="40"
                        FontSize="13" FontWeight="Bold"
                        Background="#00D4AA" Foreground="#0C1118" BorderThickness="0"
                        Margin="0,0,10,0" Cursor="Hand"
                        IsDefault="True"
                        Click="OkButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#00E8BB"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Background" Value="#2A7F6E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="BATAL" Width="120" Height="40"
                        FontSize="13" FontWeight="Bold"
                        Background="#2A3040" Foreground="#C6CEDC" BorderThickness="0"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="CancelButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A4256"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
